vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
  }
}

classes: {
  actor: {
    style: {
      fill: "#f4d35e"
      stroke: "#f4d35e"
      font-color: "#0e0e10"
      bold: true
    }
  }
  front: {
    style: {
      fill: "#6eb5ff"
      stroke: "#6eb5ff"
      font-color: "#0e0e10"
      bold: true
    }
  }
  surface: {
    style: {
      fill: "#ffb347"
      stroke: "#ffb347"
      font-color: "#0e0e10"
    }
  }
  service: {
    style: {
      fill: "#1d1d24"
      stroke: "#ffb347"
      font-color: "#f4f4f0"
    }
  }
  seam: {
    style: {
      fill: "#1d1d24"
      stroke: "#6eb5ff"
      font-color: "#f4f4f0"
    }
  }
  base: {
    style: {
      fill: "#101014"
      stroke: "#4a4a55"
      font-color: "#c9c9d4"
    }
  }
  external: {
    style: {
      fill: "#26262e"
      stroke: "#8a8a96"
      stroke-dash: 4
      font-color: "#f4f4f0"
    }
  }
}

direction: down

operator: Operator (browser) {
  class: actor
  island: SIP island — calls survive tab switches
  tabs: HTMX tabs — Messages · Fax · Voicemail · History · Contacts · Settings
}

front: TLS front (stack nginx vhost) {
  class: front
  web: "/ + /events SSE (unbuffered)"
  sip: /sip WSS — bridged to the PBX
  api: /phone-api passthrough
}

webphone: webphone Go binary {
  style: {
    stroke: "#ffb347"
    stroke-width: 2
    font-color: "#ffb347"
    bold: true
  }

  http: HTTP surface — internal/server (19 files) {
    class: surface
    chain: middleware: RequestID → Log → Timing → SecurityHeaders → Recovery → CSRF
    routes: routes: pages & partials · JSON APIs · /hooks/* · /events hubs · export
    probes: /healthz · /livez · /startupz · /metrics · /version
  }

  services: services — HTTP-free by test {
    class: service
    messaging: messaging.Service
    faxsvc: fax.Service
    sessionsvc: session (SQLite, sliding TTL)
    retention: retention sweeper (daily)
    crmres: crm.Resolver (TTL cache, single-flight)
    vcard: vcard (pure parser)
  }

  seams: seams {
    class: seam
    gateway: "gateway: loopback | webhook (multipart, Bearer)"
    pbx: pbx.Client (leaf client)
  }

  domain: domain — branded IDs · value objects · enums {
    class: base
  }
}

store: SQLite (WAL, owner-scoped) {
  shape: sql_table
  threads: threads
  messages: messages
  attachments: attachments
  fax_jobs: fax_jobs
  contacts: contacts
  sessions: sessions
}

blobs: blob tree (nanoid files) {
  shape: stored_data
  class: base
}

pbxstack: FreeSWITCH PBX {
  class: external
}
bridge: telnyx-webhooks bridge {
  class: external
}
ledger: Ledger CRM (bearer /api) {
  class: external
}

operator -> front: "HTTPS · WSS /sip"
front.web -> webphone.http.routes: proxies
front.sip -> pbxstack: "SIP over WSS"
front.api -> webphone.http.routes: passthrough
webphone.http -> webphone.services: calls
webphone.services -> webphone.seams: gateway + directory
webphone.services -> store: "owner-scoped SQL"
webphone.services -> blobs: "attachments & fax PDFs"
webphone.seams.gateway -> bridge: "outbound multipart + Bearer"
bridge -> webphone.http.routes: "inbound + status /hooks/*"
webphone.seams.pbx -> pbxstack: "phone-api (Basic auth)"
webphone.services.crmres -> ledger: "GET /api (bearer)"
webphone.http -> webphone.domain: types

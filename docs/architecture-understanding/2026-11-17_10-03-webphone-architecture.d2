vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
  }
}

classes: {
  actor: {
    style: {
      fill: "#f4d35e"
      stroke: "#f4d35e"
      font-color: "#0e0e10"
      bold: true
    }
  }
  front: {
    style: {
      fill: "#6eb5ff"
      stroke: "#6eb5ff"
      font-color: "#0e0e10"
      bold: true
    }
  }
  surface: {
    style: {
      fill: "#ffb347"
      stroke: "#ffb347"
      font-color: "#0e0e10"
    }
  }
  service: {
    style: {
      fill: "#1d1d24"
      stroke: "#ffb347"
      font-color: "#f4f4f0"
    }
  }
  seam: {
    style: {
      fill: "#1d1d24"
      stroke: "#6eb5ff"
      font-color: "#f4f4f0"
    }
  }
  infra: {
    style: {
      fill: "#101014"
      stroke: "#6eb5ff"
      font-color: "#c9c9d4"
      stroke-dash: 4
    }
  }
  base: {
    style: {
      fill: "#101014"
      stroke: "#4a4a55"
      font-color: "#c9c9d4"
    }
  }
  external: {
    style: {
      fill: "#26262e"
      stroke: "#8a8a96"
      stroke-dash: 4
      font-color: "#f4f4f0"
    }
  }
}

direction: down

operator: Operator (browser) {
  class: actor
  island: SIP island — sip.js 0.21.2, served verbatim
  tabs: HTMX tabs — real URLs + pushState, morph swaps
  login: "/login front door — passkey | extension | Pocket ID"
}

front: TLS front — Caddy (stack module) {
  class: front
  style.stroke-dash: 4
  web: reverse_proxy + /events unbuffered
  sip: /sip WSS bridge to the PBX
}

webphone: webphone single binary — current state (2026-11-17) {
  style: {
    stroke: "#ffb347"
    stroke-width: 2
    font-color: "#ffb347"
    bold: true
  }

  cmd: cmd/webphone — process lifecycle + enroll CLI {
    class: base
  }

  app: internal/app — composition root (samber/do v2) {
    class: surface
  }

  http: internal/server — HTTP hub {
    class: surface
    wiring: server.go — Deps · middleware chain · mount
    auth: server/auth — login · session · passkey · sso doors
    api: server/api — JSON surfaces (summary · notes · push · contacts)
    hooks: server/hooks — webhook ingest + idem windows
    platform: server/platform — assets · metrics · csp · trace · proxy
  }

  identity: identity {
    class: seam
    loginpage: "/login page (loginpage/v4 + ExtraSection)"
    userauth: userauth — in-process usermgmt v4
    sso: sso — Pocket ID OIDC (begin-eager discovery)
    authmap: authmap — shared users map
    session: session — SQLite rows, sliding TTL
    sipcred: sipcred — per-session derived SIP credential
    admin: admin — read-only all-lines property
  }

  comms: comms services {
    class: service
    messaging: messaging.Service — sender registry
    chatloop: chatloop — receiver backoff ladder
    matrix: matrix — /sync loop, read receipts
    signal: signal — socket reader
    faxsvc: fax.Service — lifecycle machine table
    paperless: paperless.Archiver
    gateway: gateway — loopback | webhook seam
  }

  operator_services: operator services {
    class: service
    crmres: crm.Resolver — TTL + single-flight
    textagent: textagent — AI drafts + reviews
    asr: asr.Client — /api/transcribe
    push: push — ntfy + FCM fanout
    reports: reports — CDR projection (pure)
    retention: retention — tombstones + trims
    blob: blob — atomic-write tree
    vcard: vcard — pure parser
    pbx: pbx — FreeSWITCH directory + CDR client
  }

  journal: ONE journal world — system.db {
    class: seam
    cqrs: cqrs — deciders + projections (go-cqrs-lite system)
    readmodels: readmodels — gates + view types (purity arch test)
    store: store — sessions SQL + import-only ladder (frozen)
  }

  shell: shell layer {
    class: base
    views: web/views — templ surfaces (no store/pbx reach-through)
    assets: web/assets — island JS + css embed tree
  }

  infra: shared infra {
    class: infra
    domain: internal/domain — branded IDs · value objects · zero internal imports
    config: config — env/file loader + unknown-key WARN
    httpclient: httpclient — the one timeout-bounded client
  }
}

sysdb: system.db (SQLite WAL) {
  shape: cylinder
  class: base
}
usermgmtdb: usermgmt.db (identity journal) {
  shape: cylinder
  class: base
}
blobs: blob tree (nanoid files) {
  shape: stored_data
  class: base
}

pbxstack: FreeSWITCH PBX {
  class: external
}
bridge: telnyx-webhooks bridge {
  class: external
}
kith: Kith CRM (bearer /api) {
  class: external
}
paperlessd: Paperless {
  class: external
}
matrixhs: Matrix homeserver {
  class: external
}
signald: Signal daemon {
  class: external
}
speaches: Speaches ASR (local) {
  class: external
}
ntfy: ntfy push {
  class: external
}
fcm: FCM push {
  class: external
}
pocketid: Pocket ID (OIDC IdP) {
  class: external
}

operator.island -> front.sip: "RTP/DTMF over WSS"
operator.tabs -> front.web: "htmx partials + morph"
front.web -> webphone.http: reverse proxy
front.sip -> pbxstack: "SIP over WSS"

webphone.cmd -> webphone.app: lifecycle
webphone.cmd -> webphone.identity.userauth: "enroll CLI"
webphone.app -> webphone.http: wires every Dep
webphone.app -> webphone.identity: wires
webphone.app -> webphone.comms: "wires + starts receiver loops"
webphone.app -> webphone.operator_services: wires
webphone.app -> webphone.journal: wires

webphone.http.wiring -> webphone.http.auth: mounts
webphone.http.wiring -> webphone.http.api: mounts
webphone.http.wiring -> webphone.http.hooks: mounts
webphone.http.wiring -> webphone.http.platform: mounts
webphone.http.auth -> webphone.identity.userauth: ceremonies
webphone.http.auth -> webphone.identity.sso: begin/complete
webphone.http.auth -> webphone.identity.session: mint/slide
webphone.http.api -> webphone.operator_services.push: fanout
webphone.http.api -> webphone.operator_services.textagent: drafts
webphone.http.hooks -> webphone.comms.messaging: Receive
webphone.http.hooks -> webphone.comms.faxsvc: verdicts
webphone.http.platform -> webphone.shell.assets: serves embed
webphone.http -> webphone.journal.readmodels: reads views

webphone.shell.views -> webphone.journal.readmodels: "typed props only"
webphone.shell.views -> webphone.operator_services.reports: CDR panel
webphone.shell.views -> webphone.shell.assets: css/js URLs

webphone.comms.messaging -> webphone.comms.gateway: Send
webphone.comms.gateway -> bridge: "multipart + Bearer"
bridge -> webphone.http.hooks: "/hooks/*"
pbxstack -> webphone.http.hooks: "/hooks/ring"
webphone.identity.session -> webphone.operator_services.pbx: directory verify
webphone.identity.sipcred -> pbxstack: dynamic REGISTER

webphone.comms.matrix -> webphone.comms.chatloop: reconnect ladder
webphone.comms.signal -> webphone.comms.chatloop: reconnect ladder
webphone.comms.faxsvc -> webphone.operator_services.blob: pdf store
webphone.comms.faxsvc -> webphone.operator_services.paperless: archive
webphone.comms.faxsvc -> webphone.comms.gateway: send
webphone.comms.messaging -> webphone.journal.cqrs: commands

webphone.journal.cqrs -> webphone.comms.faxsvc: machine tables
webphone.journal.cqrs -> sysdb: "events + projections"
webphone.journal.readmodels -> sysdb: "gate reads"
webphone.journal.store -> sysdb: sessions
webphone.identity.userauth -> usermgmtdb: journal
webphone.operator_services.blob -> blobs: atomic write
webphone.operator_services.retention -> sysdb: tombstones
webphone.operator_services.pbx -> pbxstack: "directory + CDR"

webphone.operator_services.crmres -> kith: bearer
webphone.operator_services.asr -> speaches: whisper
webphone.operator_services.push -> ntfy: topics
webphone.operator_services.push -> fcm: v1 API
webphone.identity.sso -> pocketid: "OIDC + PKCE"
webphone.comms.matrix -> matrixhs: /sync
webphone.comms.signal -> signald: socket

webphone.operator_services.pbx -> webphone.infra.httpclient: shared client
webphone.operator_services.crmres -> webphone.infra.httpclient: shared client
webphone.operator_services.asr -> webphone.infra.httpclient: shared client
webphone.operator_services.push -> webphone.infra.httpclient: shared client
webphone.operator_services.textagent -> webphone.infra.httpclient: shared client
webphone.comms.matrix -> webphone.infra.httpclient: shared client

package views

import (
	"fmt"
	"time"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/webphone/internal/pbx"
)

// VoicemailPanel lists the extension's voicemail from the phone API. When
// no API is configured the tab says so instead of pretending. The "voicemail"
// SSE event carries no payload (voicemail lives behind the extension's own
// PBX credentials) — it nudges the tab to re-fetch its partial instead.
type VoicemailPanelProps struct {
	Enabled  bool
	Summary  pbx.VoicemailSummary
	Messages []pbx.VoicemailMessage
	Error    string
	// Names maps phone numbers to CRM contact names (optional integration);
	// unresolved numbers render verbatim.
	Names map[string]string
	Lang  Lang
}

templ VoicemailPanel(props VoicemailPanelProps) {
	<section
		class="wp-panel"
		id="voicemail-panel"
		hx-get="/partials/voicemail"
		hx-trigger="sse:voicemail"
		hx-target="#tab-content"
		hx-swap="morph:innerHTML show:window:top"
	>
		<header class="wp-panel-head">
			<h2>{ T(props.Lang, "tab.voicemail") }</h2>
			<p class="wp-panel-sub">
				if props.Enabled {
					{ fmtInt(props.Summary.New) } { T(props.Lang, "vm.new") } · { fmtInt(props.Summary.Old) } { T(props.Lang, "vm.saved") }
				} else {
					{ T(props.Lang, "vm.needsAPI") }
				}
			</p>
		</header>
		@panelError(props.Error)
		if !props.Enabled {
			<p class="wp-empty">
				{ T(props.Lang, "vm.disabled.pre") }<code>phone_api_url</code>{ T(props.Lang, "vm.disabled.post") }
			</p>
		}
		for _, msg := range props.Messages {
			@VoicemailRow(msg, props.Names, props.Lang)
		}
		if props.Enabled && len(props.Messages) == 0 {
			@display.EmptyState(display.EmptyStateProps{Title: T(props.Lang, "vm.empty"), Icon: icons.Phone})
		}
	</section>
}

templ VoicemailRow(msg pbx.VoicemailMessage, names map[string]string, lang Lang) {
	// Stable ids are the idiomorph persistence contract: the panel re-fetch
	// morphs #tab-content on every "voicemail" nudge, and idiomorph keeps
	// any element whose id exists in BOTH trees morphing it in place — so a
	// row that moves (new voicemail lands on top) and its <audio> element
	// mid-playback survive the swap instead of being re-created. This is
	// the im-preserve audit's one stateful node across all morph surfaces
	// (thread/fax rows and transcript bubbles are static content — a
	// re-created row there costs nothing; focus is covered by idiomorph's
	// restoreFocus, which equally needs an id to restore to).
	//
	// The player chrome (shell.js §4) drives the audio element without
	// native controls: play/pause button, waveform scrubber, speed toggle.
	// When waveform decoding is unavailable (no WebAudio/fetch/canvas) the
	// shell falls back to the native controls — the audio element itself is
	// the fallback surface, which is why it stays in the DOM either way.
	<article class={ "wp-row wp-vm-row", templ.KV("wp-unread", !msg.Read) } id={ "vm-" + msg.UUID }>
		<span class="wp-thread-text">
			<strong class="wp-thread-remote">{ vmCaller(msg, names, lang) }</strong>
			<span class="wp-muted">{ vmWhen(msg.Created, lang) } · { fmtInt(msg.Seconds) }s</span>
		</span>
		<span class="wp-row-actions">
			if msg.CIDNumber != "" {
				<button class="wp-mini" data-dial={ msg.CIDNumber }>{ T(lang, "contacts.call") }</button>
				<button class="wp-mini" data-sms={ msg.CIDNumber }>{ T(lang, "contacts.sms") }</button>
				<button
					class="wp-mini"
					data-save-contact={ msg.CIDNumber }
					aria-label={ T(lang, "contacts.saveAs") }
					title={ T(lang, "contacts.saveAs") }
				>☆</button>
			}
			<button
				class="wp-mini wp-danger"
				hx-post={ "/voicemail/delete?uuid=" + msg.UUID }
				hx-target="#tab-content"
				hx-swap="innerHTML"
				hx-confirm={ T(lang, "vm.deleteConfirm") }
			>{ T(lang, "vm.delete") }</button>
		</span>
		if msg.AudioURL != "" {
			<span class="wp-vm-player">
				<button
					class="wp-mini wp-vm-play"
					type="button"
					id={ "vm-play-" + msg.UUID }
					data-vm-play={ msg.UUID }
					aria-label={ T(lang, "vm.play") }
					data-label-play={ T(lang, "vm.play") }
					data-label-pause={ T(lang, "vm.pause") }
				>▶</button>
				<canvas
					class="wp-vm-wave"
					id={ "vm-wave-" + msg.UUID }
					role="slider"
					tabindex="0"
					aria-label={ T(lang, "vm.scrub") }
					aria-valuemin="0"
					aria-valuemax={ fmtInt(msg.Seconds) }
					aria-valuenow="0"
				></canvas>
				<button
					class="wp-mini wp-vm-speed"
					type="button"
					id={ "vm-speed-" + msg.UUID }
					data-vm-speed={ msg.UUID }
					title={ T(lang, "vm.speed") }
				>1×</button>
				<span class="wp-vm-time" id={ "vm-time-" + msg.UUID }>0:00 / { vmClock(msg.Seconds) }</span>
				<audio class="wp-audio" preload="none" src={ msg.AudioURL } id={ "vm-audio-" + msg.UUID }></audio>
				<button
					class="wp-mini wp-vm-transcribe"
					type="button"
					data-transcribe-src={ msg.AudioURL }
					data-transcribe-target={ "vm-transcript-" + msg.UUID }
					aria-label={ T(lang, "vm.transcribe") }
				>{ T(lang, "vm.transcribe") }</button>
			</span>
			<div class="wp-vm-transcript" id={ "vm-transcript-" + msg.UUID } hidden></div>
		}
	</article>
}

func vmCaller(msg pbx.VoicemailMessage, names map[string]string, lang Lang) string {
	if msg.CIDNumber != "" {
		if name, ok := names[msg.CIDNumber]; ok && name != "" {
			return name
		}
	}
	if msg.CIDName != "" && msg.CIDName != msg.CIDNumber {
		return msg.CIDName + " (" + msg.CIDNumber + ")"
	}
	if msg.CIDNumber != "" {
		return msg.CIDNumber
	}
	return T(lang, "vm.unknown")
}

func vmWhen(createdUnix int64, lang Lang) string {
	return formatStamp(lang, time.Unix(createdUnix, 0))
}

// vmClock renders a duration as m:ss — the same shape shell.js renders
// client-side for the running position, so the two halves of the player
// line never disagree.
func vmClock(seconds int) string {
	if seconds < 0 {
		seconds = 0
	}
	return fmt.Sprintf("%d:%02d", seconds/60, seconds%60)
}

package views

import (
	"time"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/utils"
	"github.com/larsartmann/webphone/internal/domain"
)

// SettingsPanel is read-only runtime facts about this deployment: what the
// server is wired to and which capabilities are live. Changes happen in the
// server's config file, not in the browser — this page tells the truth
// about what is configured. The snippets section (M21) is the one
// exception: reply snippets are the user's own data, managed here.
type SettingsPanelProps struct {
	SIPDomain      string
	WebsocketURL   string
	GatewayMode    string
	// Fax is the deployment's declared fax reachability (config.Fax). The
	// row renders ONLY when a direction is missing, and names that half —
	// the gateway-mode row ("webhook") never did.
	Fax     FaxCapability
	PhoneAPI bool
	// CRMState is the Settings row's honest CRM rendering (T7): "unset"
	// (no seam — the historical off path), "connected" (bounded probe
	// 200), "auth-failed" (401/403 — rotate the token credential),
	// "setup" (configured but the probe did not answer).
	CRMState string
	// ASR reports the optional live-transcription seam; ASRDetail names
	// the provider kind and model (asr.Provider.Describe) when it is on,
	// ASRLocality carries the config-honest trust label (M17: "local" =
	// loopback/private provider, "remote" = external) that names WHERE
	// caller audio goes; empty when the seam is off.
	ASR        bool
	ASRDetail  string
	ASRLocality string
	// Paperless reports the optional inbound-fax archive (config-fax
	// audit T7, 2026-10-30): the row renders ONLY when the seam is
	// configured and states the CONFIG fact — never an uptime claim
	// (the archive leg is fire-and-forget; the blob store stays the
	// storage truth and failures belong to the journal). Off renders
	// no row: off is the deliberate default, not a missing half.
	Paperless bool
	// Agent reports the optional textagent seam (M17/M13): AgentMode is
	// the effective draft mode when the bounded probe answered (empty
	// otherwise — the row still renders, naming the seam's home). The
	// review API is a loopback stack service by doctrine, so the row
	// names the processing location config-honestly: it runs HERE.
	Agent    bool
	AgentMode string
	// ChatMatrix/ChatSignal report the optional chat-network lanes. The
	// rows render ONLY when the lane is configured (passkey-style
	// conditional): zero config keeps the panel byte-identical.
	ChatMatrix bool
	ChatSignal bool
	// Push reports the optional ring-while-closed seam; PushTransports
	// names the live wires (push.Fanout.Describe). The rows render ONLY
	// when the seam is on (the chat-lane pattern): zero config keeps the
	// panel byte-identical.
	Push           bool
	PushTransports string
	// PushDevices feeds PushDevicesSection (the session extension's
	// registered devices, newest first); the wake address (token) is
	// write-only and never reaches any view.
	PushDevices []PushDeviceRow
	ICEServers     int
	SharedContacts int
	// Snippets are the owner's reply snippets (M21), oldest first.
	Snippets []domain.Snippet
	// AgentAuditRows feeds AgentAuditSection (D5): the owner's newest
	// agent-action audit rows (the durable read model behind the
	// journal line). Rendered when rows exist OR the agent seam is on
	// (history outlives a seam toggle); identifiers only.
	AgentAuditRows []AgentAuditRow
	// Passkeys shapes the passkey management section (A2): Available
	// only when the identity layer is wired AND the extension has a
	// mapped account.
	Passkeys PasskeysSectionProps
	Lang     Lang
}

templ SettingsPanel(props SettingsPanelProps) {
	<section class="wp-panel" id="settings-panel">
		@panelHead(props.Lang, "tab.settings", "settings.subtitle")
		@display.DefinitionList(display.DefinitionListProps{
			Class: "wp-settings",
			Items: settingsItems(props),
		})
		if props.Push {
			@PushDevicesSection(props.PushDevices, props.Lang)
		}
		@SnippetsSection(props.Snippets, props.Lang)
		if len(props.AgentAuditRows) > 0 || props.Agent {
			@AgentAuditSection(props.AgentAuditRows, props.Lang)
		}
		if props.Passkeys.Available {
			@PasskeysSection(props.Passkeys)
		}
		<h3 class="wp-settings-head">{ T(props.Lang, "shortcuts.title") }</h3>
		<dl class="wp-settings wp-shortcuts">
			<dt><kbd>A</kbd></dt><dd>{ T(props.Lang, "shortcuts.a") }</dd>
			<dt><kbd>H</kbd></dt><dd>{ T(props.Lang, "shortcuts.h") }</dd>
			<dt><kbd>M</kbd></dt><dd>{ T(props.Lang, "shortcuts.m") }</dd>
			<dt><kbd>P</kbd></dt><dd>{ T(props.Lang, "shortcuts.p") }</dd>
			<dt><kbd>Esc</kbd></dt><dd>{ T(props.Lang, "shortcuts.esc") }</dd>
			<dt><kbd>[</kbd>/<kbd>]</kbd></dt><dd>{ T(props.Lang, "shortcuts.cycle") }</dd>
			<dt><kbd>Enter</kbd></dt><dd>{ T(props.Lang, "shortcuts.enter") }</dd>
			<dt><kbd>Shift</kbd>+<kbd>Enter</kbd></dt><dd>{ T(props.Lang, "shortcuts.shiftEnter") }</dd>
			<dt><kbd>Ctrl</kbd>/<kbd>Cmd</kbd>+<kbd>K</kbd></dt><dd>{ T(props.Lang, "shortcuts.palette") }</dd>
			<dt><kbd>?</kbd></dt><dd>{ T(props.Lang, "shortcuts.help") }</dd>
		</dl>
		<p class="wp-empty">
			{ T(props.Lang, "settings.themeNote") }
		</p>
	</section>
}

// PushDeviceRow is one registered ring-while-closed device in the
// Settings list: identity and recency only — the wake address (token)
// is write-only and never reaches any view.
//
// brandid-lint:ignore(BD003) view row: the device id is a foreign
// client-generated install identity, not a domain entity (strong-id
// wire ruling).
type PushDeviceRow struct {
	ID        string
	Transport string
	UpdatedAt time.Time
}

// AgentAuditRow is one durable agent-action audit row in the Settings
// history (D5): who acted (the login email, else the line itself), the
// event vocabulary (approve, discard, mode, auto_review…), the subject
// (draft/call id) when one was named, the outcome, the stamp.
// Identifiers only — the same contract as the journal line.
//
// brandid-lint:ignore(BD003) view row: audit tokens are the journal-line
// vocabulary, not domain entities (strong-id wire ruling).
type AgentAuditRow struct {
	Actor   string
	Event   string
	Subject string
	Outcome string
	At     time.Time
}

templ AgentAuditSection(rows []AgentAuditRow, lang Lang) {
	<h3 class="wp-settings-head" id="wp-agent-audit-head">{ T(lang, "settings.audit.title") }</h3>
	<p class="wp-empty">{ T(lang, "settings.audit.subtitle") }</p>
	if len(rows) == 0 {
		<p class="wp-empty" id="wp-agent-audit-empty">{ T(lang, "settings.audit.empty") }</p>
	} else {
		<ul class="wp-snippet-manage" id="wp-agent-audit-list">
			for _, row := range rows {
				<li class="wp-snippet-row">
					<span class="wp-snippet-body">{ row.line() }</span>
					<span class="wp-muted">{ formatFor(lang, row.At.Local(), "02.01. 15:04", "Jan 2, 3:04PM") }</span>
				</li>
			}
		</ul>
	}
}

func (r AgentAuditRow) line() string {
	line := r.Actor + " · " + r.Event + " · " + r.Outcome
	if r.Subject != "" {
		line += " · " + r.Subject
	}
	return line
}

// PasskeysSection manages the mapped account's passkeys (A2): the
// enrolled keys with their device names and enrollment dates, each with
// a revoke button. Revoke answers a toast + the whole settings partial
// re-render (the snippets pattern), so the list always shows store
// truth. The id is the base64url credential id — a revoke handle only,
// never key material.
type PasskeyCredentialView struct {
	ID        string
	Name      string
	CreatedAt time.Time
}

type PasskeysSectionProps struct {
	Available   bool
	Empty       bool
	Credentials []PasskeyCredentialView
	Lang        Lang
}

templ PasskeysSection(props PasskeysSectionProps) {
	<h3 class="wp-settings-head" id="wp-passkeys-head">{ T(props.Lang, "passkeys.title") }</h3>
	<p class="wp-empty">{ T(props.Lang, "passkeys.subtitle") }</p>
	if props.Empty {
		<p class="wp-empty" id="wp-passkeys-empty">{ T(props.Lang, "passkeys.empty") }</p>
	} else {
		<ul class="wp-snippet-manage" id="wp-passkeys-list">
			for _, cred := range props.Credentials {
				<li class="wp-snippet-row">
					<span class="wp-snippet-body">{ cred.displayName() }</span>
					<span class="wp-muted">{ cred.CreatedAt.Format("2006-01-02") }</span>
					<button
						type="button"
						class="wp-mini"
						hx-delete={ "/api/passkeys/" + cred.ID }
						hx-target="#tab-content"
						hx-swap="innerHTML"
						hx-confirm={ T(props.Lang, "passkeys.confirm") }
						aria-label={ T(props.Lang, "passkeys.revoke") }
						title={ T(props.Lang, "passkeys.revoke") }
					>@icons.Icon(icons.Close, "wp-icon")</button>
				</li>
			}
		</ul>
	}
}

func (c PasskeyCredentialView) displayName() string {
	if c.Name == "" {
		return "passkey"
	}
	return c.Name
}

// PushDevicesSection lists the session extension's registered
// ring-while-closed devices. Read-only: registration and deregistration
// are the native shells' login/logout contract, so the panel only shows
// the store's truth.
templ PushDevicesSection(devices []PushDeviceRow, lang Lang) {
	<h3 class="wp-settings-head">{ T(lang, "push.title") }</h3>
	if len(devices) == 0 {
		<p class="wp-empty">{ T(lang, "push.empty") }</p>
	} else {
		<ul class="wp-snippet-manage">
			for _, device := range devices {
				<li class="wp-snippet-row">
					<span class="wp-snippet-body">{ device.ID }</span>
					<span class="wp-muted">{ device.Transport } · { device.UpdatedAt.Format("2006-01-02") }</span>
				</li>
			}
		</ul>
	}
}

func orUnset(value string, lang Lang) string {
	if value == "" {
		return T(lang, "err.requestHost")
	}
	return value
}

// settingsFaxKey is the one home of the fax-row vocabulary: it names
// the lanes' state — the missing direction with its reason when one is
// off, and the plain "both available" fact when neither is. The row
// renders for EVERY deployment (owner decision 2, 2026-10-30: symmetric
// rows read better than a row that only ever reports bad news).
func settingsFaxKey(cap FaxCapability) string {
	switch {
	case cap.Send && cap.Receive:
		return "settings.fax.on"
	case !cap.Send && !cap.Receive:
		return "settings.fax.off"
	case !cap.Send:
		return "settings.fax.sendOff"
	default:
		return "settings.fax.receiveOff"
	}
}

// settingsItems builds the deployment-facts rows for the DefinitionList
// (the settingsRow adoption, dedup registry 2026-10-11 ruling #2): plain
// Detail strings for text values, DetailComponent where the value is
// conditional or rich (service state, ASR detail, the export link).
func settingsItems(props SettingsPanelProps) []display.DefinitionItem {
	items := []display.DefinitionItem{
		{Term: T(props.Lang, "settings.sipDomain"), Detail: orUnset(props.SIPDomain, props.Lang)},
		{Term: T(props.Lang, "settings.sipWS"), Detail: props.WebsocketURL},
		{Term: T(props.Lang, "settings.ice"), Detail: fmtInt(props.ICEServers)},
		{Term: T(props.Lang, "settings.gateway"), Detail: props.GatewayMode},
	}
	// The fax row renders for EVERY deployment (owner decision 2,
	// 2026-10-30 — docs/planning/2026-10-30_04-15_fax-decision.md): a
	// lane that works is also a deployment fact worth stating, and a
	// row that only ever reports bad news reads as an error. The pill
	// carries the lanes' state; its on/off class follows whether ANY
	// lane is up. This deliberately ends the Settings byte-parity era
	// — the new markup is pinned by the view tests instead.
	items = append(items, display.DefinitionItem{Term: T(props.Lang, "settings.fax"), DetailComponent: faxLaneDetail(props.Fax, props.Lang)})
	items = append(items,
		display.DefinitionItem{Term: T(props.Lang, "settings.phoneAPI"), DetailComponent: serviceDetail(props.PhoneAPI, T(props.Lang, "settings.connected"), T(props.Lang, "settings.unset"))},
		display.DefinitionItem{Term: T(props.Lang, "settings.crm"), DetailComponent: crmDetail(props.CRMState, props.Lang)},
		display.DefinitionItem{Term: T(props.Lang, "settings.asr"), DetailComponent: serviceDetailExtra(props.ASR, asrDetailWithLocality(props), T(props.Lang, "settings.connected"), T(props.Lang, "settings.unset"))},
		display.DefinitionItem{Term: T(props.Lang, "settings.shared"), Detail: fmtInt(props.SharedContacts)},
		display.DefinitionItem{Term: T(props.Lang, "settings.export"), DetailComponent: exportLink(T(props.Lang, "settings.exportLink"))},
	)
	// The agent row (M17) surfaces only when the textagent seam is
	// wired (an always-on "off" row would be noise for every
	// telephony-only deployment).
	if props.Agent {
		items = append(items, display.DefinitionItem{Term: T(props.Lang, "settings.agent"), DetailComponent: serviceDetailExtra(true, agentDetail(props), T(props.Lang, "settings.connected"), T(props.Lang, "settings.unset"))})
	}
	// The Paperless row (capability-fax audit T7) surfaces only when the
	// archive seam is configured: it states the config fact — inbound
	// faxes are copied to the archive — without claiming uptime (the
	// copy is fire-and-forget; the journal owns failures). Off renders
	// no row and the zero-config panel stays byte-identical.
	if props.Paperless {
		items = append(items, display.DefinitionItem{Term: T(props.Lang, "settings.paperless"), DetailComponent: serviceDetail(true, T(props.Lang, "settings.paperless.on"), "")})
	}
	// Chat-network lanes surface only when they exist (an always-on
	// "off" row would be noise for every telephony-only deployment).
	if props.ChatMatrix {
		items = append(items, display.DefinitionItem{Term: T(props.Lang, "settings.matrix"), DetailComponent: serviceDetail(true, T(props.Lang, "settings.connected"), T(props.Lang, "settings.unset"))})
	}
	if props.ChatSignal {
		items = append(items, display.DefinitionItem{Term: T(props.Lang, "settings.signal"), DetailComponent: serviceDetail(true, T(props.Lang, "settings.connected"), T(props.Lang, "settings.unset"))})
	}
	// The push seam surfaces only when a transport is configured; the
	// muted tail names the live wires (raw service vocabulary, like the
	// gateway-mode row).
	if props.Push {
		items = append(items, display.DefinitionItem{Term: T(props.Lang, "settings.push"), DetailComponent: serviceDetailExtra(props.Push, props.PushTransports, T(props.Lang, "settings.connected"), T(props.Lang, "settings.unset"))})
	}
	return items
}

templ serviceDetail(on bool, connected, unset string) {
	<span class={ "wp-service", templ.KV("wp-service-on", on), templ.KV("wp-service-off", !on) }>
		if on {
			{ connected }
		} else {
			{ unset }
		}
	</span>
}

// faxLaneDetail is the fax row's pill: the lanes' state vocabulary
// ALWAYS renders (both the on and the off phrasings are facts), while
// the on/off class follows whether any lane is up — unlike
// serviceDetail, whose connected/unset pair replaces one phrasing with
// another.
templ faxLaneDetail(cap FaxCapability, lang Lang) {
	<span class={ "wp-service", templ.KV("wp-service-on", cap.Any()), templ.KV("wp-service-off", !cap.Any()) }>
		{ T(lang, settingsFaxKey(cap)) }
	</span>
}

// crmDetail renders the CRM row's honest state (T7): the four states
// the bounded probe can distinguish. Unknown state strings fall back to
// the unset rendering (a stale prop can never claim a live wire).
templ crmDetail(state string, lang Lang) {
	<span class={ "wp-service", templ.KV("wp-service-on", state == "connected") }>
		if state == "connected" {
			{ T(lang, "settings.connected") }
		} else if state == "auth-failed" {
			{ T(lang, "settings.crmAuthFailed") }
		} else if state == "setup" {
			{ T(lang, "settings.crmSetup") }
		} else {
			{ T(lang, "settings.unset") }
		}
	</span>
}

// serviceDetailExtra is serviceDetail with a muted tail for the live
// wire names (the ASR provider kind·model, the push transports).
templ serviceDetailExtra(on bool, extra, connected, unset string) {
	<span class={ "wp-service", templ.KV("wp-service-on", on), templ.KV("wp-service-off", !on) }>
		if on {
			{ connected }
			if extra != "" {
				<span class="wp-muted"> · { extra }</span>
			}
		} else {
			{ unset }
		}
	</span>
}

templ exportLink(label string) {
	<a class="wp-mini" href="/api/export" download>{ label }</a>
}

// asrDetailWithLocality appends the config-honest processing-location
// sentence (M17) to the provider line: WHERE caller audio goes is a
// trust fact, not an implementation detail.
func asrDetailWithLocality(props SettingsPanelProps) string {
	if !props.ASR {
		return props.ASRDetail
	}
	if props.ASRLocality == "local" {
		return props.ASRDetail + " · " + T(props.Lang, "settings.asr.local")
	}
	return props.ASRDetail + " · " + T(props.Lang, "settings.asr.remote")
}

// agentDetail names the draft mode (when the bounded probe answered)
// and the processing location: the review API is a loopback stack
// service by doctrine, so the row can name its home config-honestly.
func agentDetail(props SettingsPanelProps) string {
	detail := T(props.Lang, "settings.agent.local")
	if props.AgentMode != "" {
		detail = T(props.Lang, "settings.agent.detail") + ": " + props.AgentMode + " · " + detail
	}
	return detail
}

// SnippetsSection manages the reply snippets (M21): the list with a
// quick marker and delete buttons, plus the add form (body + quick
// checkbox). Save/delete answer toast + this whole settings partial
// re-render, so the list always shows the store's truth (one home: the
// snippets table). Delete buttons target the panel — they are type=button
// inside no form, riding their own hx-post.
templ SnippetsSection(snippets []domain.Snippet, lang Lang) {
	<h3 class="wp-settings-head">{ T(lang, "snippets.title") }</h3>
	<p class="wp-empty">{ T(lang, "snippets.subtitle") }</p>
	if len(snippets) == 0 {
		<p class="wp-empty">{ T(lang, "snippets.empty") }</p>
	} else {
		<ul class="wp-snippet-manage">
			for _, snippet := range snippets {
				<li class="wp-snippet-row">
					<span class="wp-snippet-body">{ snippet.Body }</span>
					if snippet.Quick {
						<span class="wp-snippet-quick" title={ T(lang, "snippets.quick") } aria-label={ T(lang, "snippets.quick") }>@icons.Icon(icons.Bolt, "wp-icon")</span>
					}
					<button
						type="button"
						class="wp-mini"
						hx-post={ "/snippets/delete?id=" + snippet.ID.String() }
						hx-target="#tab-content"
						hx-swap="innerHTML"
						aria-label={ T(lang, "snippets.delete") }
						title={ T(lang, "snippets.delete") }
					>@icons.Icon(icons.Close, "wp-icon")</button>
				</li>
			}
		</ul>
	}
	<form
		class="wp-snippet-add"
		hx-post="/snippets/save"
		hx-target="#tab-content"
		hx-swap="innerHTML"
		hx-disabled-elt="find button[type=submit]"
	>
		@forms.Textarea(forms.TextareaProps{
			BaseProps: utils.BaseProps{
				AriaLabel: T(lang, "snippets.body"),
			},
			Name:        "body",
			Rows:        2,
			Placeholder: T(lang, "snippets.body"),
		})
		<label class="wp-snippet-quick-label">
			<input type="checkbox" name="quick" value="1"></input>
			{ T(lang, "snippets.quick") }
		</label>
		@display.Button(display.ButtonProps{Type: display.ButtonHTMLSubmit, Text: T(lang, "snippets.add")})
	</form>
	}

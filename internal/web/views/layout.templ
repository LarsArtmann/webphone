package views

import 	"github.com/larsartmann/templ-components/layout"

// Tab is one switchable content region; navigation swaps them with HTMX
// partial requests so the SIP island never unloads mid-call.
type Tab string

const (
	TabMessages  Tab = "messages"
	TabFax       Tab = "fax"
	TabVoicemail Tab = "voicemail"
	TabHistory   Tab = "history"
	TabContacts  Tab = "contacts"
	TabSettings  Tab = "settings"
)

// AllTabs is the navigation order.
var AllTabs = []Tab{TabMessages, TabFax, TabVoicemail, TabHistory, TabContacts, TabSettings}

// Path returns the tab's route.
func (t Tab) Path() string { return "/" + string(t) }

// ShellProps carries everything the outer page needs.
type ShellProps struct {
	ActiveTab Tab
	// SignedIn shows the signed-in extension in the header (empty = the
	// island still shows its login card).
	SignedIn string
	// SignedInDID is the extension's presented PSTN number (config
	// identities); empty = unknown, header shows the extension alone.
	SignedInDID string
	// CSRFToken rides in hx-headers so every HTMX POST is protected.
	CSRFToken string
	// CSRFHxHeaders is the rendered value of the hx-headers attribute —
	// raw JSON (templ escapes attribute values itself), built from
	// CSRFToken at render time.
	CSRFHxHeaders string
	// TabContent renders the active tab's region.
	TabContent templ.Component
	// Unread counts badge the Messages nav item.
	Unread int
	// NewVoicemail counts badge the Voicemail nav item.
	NewVoicemail int
	// Lang drives the server-rendered strings.
	Lang Lang
}

// Shell is the whole application page: header, the persistent SIP island
// (calls survive tab switches because this markup never unloads), and the
// HTMX-swapped tab region.
templ Shell(props ShellProps) {
	@layout.Base(layout.PageProps{
		Title:          "WebPhone",
		Description:    "Self-hosted unified communications: calls, messages, fax and voicemail over SIP/WebRTC.",
		ThemeColor:     "#0f766e",
		DarkThemeColor: "#10161a",
		CSSPath:        "/assets/app.css",
		Favicon:        "/favicon.svg",
		Nonce:          "",
		SEO:            layout.SEOMeta{NoIndex: true},
		// NoThemeScript: the library's inline dark-mode preload violates the
		// zero-inline-script CSP — the same job is done pre-paint by the
		// same-origin /assets/theme-preload.js loaded in headExtras below.
		NoThemeScript: true,
		HeadContent:   headExtras(props.CSRFToken),
		BodyDataAttrs: bodyAttrs(props),
	}) {
		if props.SignedIn != "" {
			<div class="wp-root" hx-ext="sse" sse-connect="/events">
				@ShellBody(props)
			</div>
		} else {
			<div class="wp-root">
				@ShellBody(props)
			</div>
		}
		@IslandScripts()
	}
}

templ ShellBody(props ShellProps) {
	<header class="wp-header">
		<a class="wp-brand" href="/" aria-label="WebPhone home">
			<svg class="wp-brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
				<rect width="32" height="32" rx="7" class="wp-mark-bg"></rect>
				<path
					d="M9 7h4l2 5-2.5 2a12 12 0 0 0 5.5 5.5L20 17l5 2v4a2 2 0 0 1-2.2 2A17.8 17.8 0 0 1 7 9.2 2 2 0 0 1 9 7z"
					class="wp-mark-fg"></path>
			</svg>
			<span>WebPhone</span>
		</a>
		<div class="wp-header-actions">
			if props.SignedIn != "" {
				<span class="wp-signed-in">{ props.SignedIn }
					if props.SignedInDID != "" {
						<span class="wp-signed-in-did"> · { props.SignedInDID }</span>
					}
				</span>
			}
			<button id="theme-toggle" class="wp-theme-toggle" type="button" title="Color theme (auto, light, dark)">Theme: auto</button>
		</div>
	</header>
	<div class="wp-body">
		<aside class="wp-island" aria-label="Phone">
			@PhoneIsland()
		</aside>
		<div class="wp-main-col">
			<nav class="wp-nav" id="wp-nav" aria-label="Sections">
				@NavLinks(props)
			</nav>
			<main class="wp-content" id="tab-content">
				if props.TabContent != nil {
					@props.TabContent
				} else {
					@SignInHint(props.Lang)
				}
			</main>
			<div id="wp-tab-error"></div>
		</div>
	</div>
}

templ NavLinks(props ShellProps) {
	for _, tab := range AllTabs {
		<a
			class={ "wp-nav-link", templ.KV("wp-active", props.ActiveTab == tab) }
			href={ tab.Path() }
			hx-get={ "/partials" + tab.Path() }
			hx-target="#tab-content"
			hx-swap="innerHTML show:window:top"
			hx-push-url={ tab.Path() }
			data-tab={ string(tab) }
		>
			<span>{ T(props.Lang, "tab."+string(tab)) }</span>
			if tab == TabMessages && props.Unread > 0 {
				<span class="wp-nav-badge">{ fmtInt(props.Unread) }</span>
			}
			if tab == TabVoicemail && props.NewVoicemail > 0 {
				<span class="wp-nav-badge">{ fmtInt(props.NewVoicemail) }</span>
			}
		</a>
	}
}

// panelHead is the one home for the panel header shape (title +
// subtitle) every tab panel opens with. Voicemail's conditional
// subtitle and ThreadView's back-link head are different shapes and
// stay hand-rolled.
templ panelHead(lang Lang, titleKey, subtitleKey string) {
	<header class="wp-panel-head">
		<h2>{ T(lang, titleKey) }</h2>
		<p class="wp-panel-sub">{ T(lang, subtitleKey) }</p>
	</header>
}

// errorBanner is the one home of the error node itself: the .wp-error
// p that htmx's responseHandling config selects on 4xx/5xx swaps, so
// its bytes are a wire contract. ErrorPanel renders it unconditionally
// (the error IS the panel); panelError adds the optional wrapper the
// data panels need.
templ errorBanner(message string) {
	<p class="wp-error" role="alert">{ message }</p>
}

// panelError renders the error banner only when there is one — the
// shared failure surface every tab panel opens with.
templ panelError(message string) {
	if message != "" {
		@errorBanner(message)
	}
}

// identityLine is the one home of the from-identity line the composer
// panels render when the deployment knows the extension's DID.
templ identityLine(lang Lang, identity string) {
	if identity != "" {
		<p class="wp-identity">{ T(lang, "identity.from") } <strong>{ identity }</strong></p>
	}
}

// headExtras applies the theme BEFORE anything paints (render-blocking,
// same-origin — the CSP allows no inline scripts), loads htmx deferred —
// AFTER the htmx-config meta, so htmx sees it at startup and skips its
// CSP-hostile inline indicator styles — then the SSE + idiomorph
// extension bundle in ONE request (cqrshtmx.HTMXExtensionsHandler behind
// /htmx-ext.js), the island stylesheet (after app.css so its element
// rules win), and the tiny shell script that tracks the active nav item
// across partial swaps.
templ headExtras(csrfToken string) {
	<script src="/assets/theme-preload.js"></script>
	<meta name="csrf-token" content={ csrfToken }></meta>
	<meta
		name="htmx-config"
		content='{"includeIndicatorStyles":false,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"401","swap":false,"error":true},{"code":"[45]..","swap":true,"error":true,"target":"#wp-tab-error","select":".wp-error"}]}'
	></meta>
	<script src="/htmx.min.js" defer></script>
	<script src="/htmx-ext.js" defer></script>
	<link rel="stylesheet" href="/assets/island/style.css"></link>
	<script src="/assets/shell.js" defer></script>
}

// bodyAttrs wires CSRF into every HTMX request. The value is raw JSON:
// templ HTML-escapes the attribute exactly once on render, so using the
// pre-escaped httputil helper here would double-escape and break hx-headers
// parsing (dropping CSRF protection from every HTMX request).
func bodyAttrs(props ShellProps) templ.Attributes {
	return templ.Attributes{
		"hx-headers": props.CSRFHxHeaders,
	}
}

// SignInHint fills the tab region while nobody is signed in: a short
// product story plus the one action that unlocks everything (signing in
// on the phone panel to the left).
templ SignInHint(lang Lang) {
	<section class="wp-panel wp-welcome">
		<h2 class="wp-welcome-title">{ T(lang, "welcome.title") }</h2>
		<p class="wp-welcome-body">{ T(lang, "welcome.body") }</p>
		<ul class="wp-welcome-points">
			<li>{ T(lang, "welcome.point1") }</li>
			<li>{ T(lang, "welcome.point2") }</li>
			<li>{ T(lang, "welcome.point3") }</li>
		</ul>
		<p class="wp-welcome-hint">{ T(lang, "signin.hint") }</p>
	</section>
}

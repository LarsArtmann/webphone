package views

import 	"github.com/larsartmann/templ-components/icons"
import 	"github.com/larsartmann/templ-components/layout"
import 	"github.com/larsartmann/webphone/internal/web/assets"

// Tab is one switchable content region; navigation swaps them with HTMX
// partial requests so the SIP island never unloads mid-call.
type Tab string

const (
	TabMessages  Tab = "messages"
	TabFax       Tab = "fax"
	TabVoicemail Tab = "voicemail"
	TabHistory   Tab = "history"
	// TabReports answers "what is this adding up to" over the same call
	// records History lists (issue #12): talk time, direction and
	// outcome, the daily shape, the busiest hours and the contacts that
	// consumed the time.
	TabReports   Tab = "reports"
	TabContacts  Tab = "contacts"
	TabSettings  Tab = "settings"
	// TabAdmin is the cross-line admin surface (read-only visibility
	// over every owner's messages, faxes, calls, users and numbers). It
	// renders ONLY for admin sessions — NavLinks skips it otherwise, so
	// a deployment without admins is byte-identical to one without the
	// feature.
	TabAdmin Tab = "admin"
)

// AllTabs is the navigation order (TabAdmin rides at the end; NavLinks
// hides it from non-admin sessions).
var AllTabs = []Tab{TabMessages, TabFax, TabVoicemail, TabHistory, TabReports, TabContacts, TabSettings, TabAdmin}

// Path returns the tab's route.
func (t Tab) Path() string { return "/" + string(t) }

// ShellProps carries everything the outer page needs.
type ShellProps struct {
	ActiveTab Tab
	// SignedIn shows the signed-in extension in the header (empty = the
	// island still shows its login card).
	SignedIn string
	// SignedInDID is the extension's presented PSTN number (config
	// identities); empty = unknown, header shows the extension alone.
	SignedInDID string
	// CSRFToken rides in hx-headers so every HTMX POST is protected.
	CSRFToken string
	// CSRFHxHeaders is the rendered value of the hx-headers attribute —
	// raw JSON (templ escapes attribute values itself), built from
	// CSRFToken at render time.
	CSRFHxHeaders string
	// TabContent renders the active tab's region.
	TabContent templ.Component
	// Unread counts badge the Messages nav item.
	Unread int
	// NewVoicemail counts badge the Voicemail nav item.
	NewVoicemail int
	// Passkey renders the island's passkey (WebAuthn) front door with
	// the extension login demoted to break-glass. False keeps the served
	// shell byte-equivalent to the pre-passkey login card.
	Passkey bool
	// SSO renders the OIDC (Pocket ID) front door: one link into the
	// IdP's authorization-code + PKCE dance. False renders nothing, so
	// deployments without OIDC keep their exact login card.
	SSO bool
	// Admin renders the Admin tab in the nav: the signed-in session's
	// login email carries the admin flag (resolved per request from the
	// live mapping). False keeps the served shell byte-equivalent to a
	// non-admin build.
	Admin bool
	// LiveContext renders the island's live-call context slot (issue #10):
	// the aside gains an empty container the shell fills from
	// /partials/live-context while a call runs. False (the CRM off, which
	// is the default) keeps the served markup byte-identical to a
	// deployment that never had the integration.
	LiveContext bool
	// Lang drives the server-rendered strings.
	Lang Lang
}

// Shell is the whole application page: header, the persistent SIP island
// (calls survive tab switches because this markup never unloads), and the
// HTMX-swapped tab region.
templ Shell(props ShellProps) {
	@layout.Base(layout.PageProps{
		Title:          "WebPhone",
		Description:    "Self-hosted unified communications: calls, messages, fax and voicemail over SIP/WebRTC.",
		ThemeColor:     "#0e8752",
		DarkThemeColor: "#17a467",
		CSSPath:        "/assets/app.css",
		Favicon:        "/favicon.svg",
		Nonce:          "",
		// Locale becomes the html lang attribute — the per-extension
		// session language, so screen readers and hyphenation follow en/de
		// instead of the library's hardcoded "en" default.
		Locale:         string(props.Lang),
		SEO:            layout.SEOMeta{NoIndex: true},
		// NoThemeScript: the library's inline dark-mode preload violates the
		// zero-inline-script CSP — the same job is done pre-paint by the
		// same-origin /assets/theme-preload.js loaded in headExtras below.
		NoThemeScript: true,
		HeadContent:   headExtras(props.CSRFToken),
		BodyDataAttrs: bodyAttrs(props),
	}) {
		if props.SignedIn != "" {
			<div class="wp-root" hx-ext="sse" sse-connect="/events">
				@ShellBody(props)
			</div>
		} else {
			<div class="wp-root">
				@ShellBody(props)
			</div>
		}
		@IslandScripts()
	}
}

templ ShellBody(props ShellProps) {
	<a class="wp-skip" href="#tab-content">{ T(props.Lang, "skip.content") }</a>
	<header class="wp-header">
		<h1 class="wp-brand-h1">
			<a class="wp-brand" href="/" aria-label="WebPhone home">
				<svg class="wp-brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
					<rect width="32" height="32" rx="7" class="wp-mark-bg"></rect>
					<path
						d="M9 7h4l2 5-2.5 2a12 12 0 0 0 5.5 5.5L20 17l5 2v4a2 2 0 0 1-2.2 2A17.8 17.8 0 0 1 7 9.2 2 2 0 0 1 9 7z"
						class="wp-mark-fg"></path>
				</svg>
				<span>WebPhone</span>
			</a>
		</h1>
		<div class="wp-header-actions">
			if props.SignedIn != "" {
				<span class="wp-signed-in">{ props.SignedIn }
					if props.SignedInDID != "" {
						<span class="wp-signed-in-did"> · { props.SignedInDID }</span>
					}
				</span>
			}
			// The phone panel collapses on desktop (P2) so a wide tab — a
			// master-detail Messages view, a long fax list, settings — gets
			// the full width. Rendered only when signed in: signed out the
			// island IS the login card, and hiding it would hide the only
			// actionable thing on the page. shell.js §4b owns the toggle;
			// theme-preload.js applies the stored state before first paint.
			//
			// A LABELLED control, not a bare glyph: a 30px chevron wedged
			// between the identity pill and the theme toggle is a feature
			// nobody finds, and an unfound feature delivers nothing. The
			// chevron pair still carries the direction (both rendered, swapped
			// by CSS per state) and aria-expanded carries the state.
			if props.SignedIn != "" {
				<button
					id="wp-island-toggle"
					class="wp-icon-toggle"
					type="button"
					aria-controls="wp-island"
					aria-expanded="true"
					title={ T(props.Lang, "shell.island.toggle") }
				>
					<span class="wp-island-toggle-hide">@icons.Icon(icons.ChevronLeft, "wp-icon")</span>
					<span class="wp-island-toggle-show">@icons.Icon(icons.ChevronRight, "wp-icon")</span>
					<span class="wp-island-toggle-label">{ T(props.Lang, "shell.island.toggle") }</span>
				</button>
			}
			// The command palette's coarse-pointer entry (F12): keyboard users
			// own Ctrl/Cmd+K and the "?" help documents it; touch has no
			// keyboard, so this header button opens the same overlay. app.css
			// reveals the button only on (pointer: coarse) — the desktop
			// chrome stays byte-identical.
			// aria-expanded is the state channel for the dialog it opens: the
			// button is a disclosure, so a screen reader must be able to tell
			// whether the palette is showing (it stays false when the overlay
			// is opened from the keyboard, which is correct — the button is
			// not the control in that path, and the dialog announces itself).
			<button id="wp-palette-open" class="wp-palette-open" type="button" aria-label="Command palette" aria-controls="wp-palette" aria-expanded="false" title="Command palette">@icons.Icon(icons.Search, "wp-icon")</button>
			<button id="theme-toggle" class="wp-theme-toggle" type="button" title="Color theme (auto, light, dark)">Theme: auto</button>
		</div>
	</header>
	<div class="wp-body">
		<aside class="wp-island" id="wp-island" aria-label="Phone">
			@PhoneIsland(PhoneIslandProps{Passkey: props.Passkey, SSO: props.SSO})
			// The live call's CRM context (issue #10). One fixed slot, filled
			// by the shell from /partials/live-context when a call starts and
			// emptied when the last one ends: an empty answer renders nothing
			// inside it, so the slot costs no layout shift.
			if props.LiveContext {
				<div id="wp-live-context" class="wp-live-context"></div>
			}
		</aside>
		<div class={ "wp-main-col", templ.KV("wp-signed-out", props.SignedIn == "") }>
			<nav class="wp-nav" id="wp-nav" aria-label="Sections">
				@NavLinks(props)
			</nav>
			// M26: the error slot renders ABOVE the panel — at panel height
			// an error swapped in below the main never scrolled into view,
			// and a slot the eye never meets is a slot that does not exist.
			// Still outside #tab-content, so tab swaps cannot remove the
			// retarget anchor.
			<div id="wp-tab-error"></div>
			<main class="wp-content" id="tab-content" tabindex="-1">
				if props.TabContent != nil {
					@props.TabContent
				} else {
					@SignInHint(props.Lang)
				}
			</main>
			// Skeleton placeholder (F1): the shell reveals this while a
			// navigation partial is in flight, so a slow tab reads as
			// loading instead of dead air.
			<div id="wp-tab-skeleton" class="wp-skeleton" hidden aria-hidden="true">
				<span></span>
				<span></span>
				<span></span>
			</div>
		</div>
	</div>
	// The SR-only live region the shell announces through (new-message
	// pushes): visually silent, politely spoken.
	<div id="wp-live" class="sr-only" role="status" aria-live="polite"></div>
}

templ NavLinks(props ShellProps) {
	// F19: a signed-out page is a door, not a floor plan — the tab row
	// exists only for a session that can use it. The nav REGION stays
	// (the post-login re-fetch targets #wp-nav); anonymously it renders
	// zero links instead of seven dead doors.
	if props.SignedIn != "" {
		for _, tab := range AllTabs {
			// templ has no loop `continue`: the admin tab's visibility is an
			// if-guard around the whole link (a non-admin session renders no
			// admin nav entry at all).
			if tab != TabAdmin || props.Admin {
				<a
					class={ "wp-nav-link", templ.KV("wp-active", props.ActiveTab == tab) }
					href={ tab.Path() }
					aria-current={ currentAttr(props.ActiveTab == tab) }
					hx-get={ "/partials" + tab.Path() }
					hx-target="#tab-content"
					hx-swap="innerHTML show:window:top"
					hx-push-url={ tab.Path() }
					data-tab={ string(tab) }
				>
					<span>{ T(props.Lang, "tab."+string(tab)) }</span>
					if tab == TabMessages && props.Unread > 0 {
						<span class="wp-nav-badge" aria-label={ badgeCount(props.Lang, props.Unread, "nav.unread") }>{ fmtInt(props.Unread) }</span>
					}
					if tab == TabVoicemail && props.NewVoicemail > 0 {
						<span class="wp-nav-badge" id="wp-nav-vm-badge" aria-label={ badgeCount(props.Lang, props.NewVoicemail, "nav.new") }>{ fmtInt(props.NewVoicemail) }</span>
					}
				</a>
			}
		}
	}
}

// currentAttr renders the spec-exact aria-current value: "page" marks
// the active tab, "false" states the rest explicitly (the attribute is
// always written, so the shell's swap-time toggle flips between the two
// definite values instead of adding/removing).
func currentAttr(active bool) string {
	if active {
		return "page"
	}
	return "false"
}

// badgeCount composes an SR label for a nav badge ("3 unread"): the
// visible text stays the bare count, the accessible name carries the
// meaning (screen readers announce badges, not just numbers).
func badgeCount(lang Lang, n int, key string) string {
	return fmtInt(n) + " " + T(lang, key)
}

// panelHead is the one home for the panel header shape (title +
// subtitle) every tab panel opens with. Voicemail's conditional
// subtitle and ThreadView's back-link head are different shapes and
// stay hand-rolled.
templ panelHead(lang Lang, titleKey, subtitleKey string) {
	<header class="wp-panel-head">
		<h2 tabindex="-1">{ T(lang, titleKey) }</h2>
		<p class="wp-panel-sub">{ T(lang, subtitleKey) }</p>
	</header>
}

// errorBanner is the one home of the error node itself: the .wp-error
// p that htmx's responseHandling config selects on 4xx/5xx swaps, so
// its bytes are a wire contract. ErrorPanel renders it unconditionally
// (the error IS the panel); panelError adds the optional wrapper the
// data panels need.
templ errorBanner(message string) {
	<p class="wp-error" role="alert">{ message }</p>
}

// panelError renders the error banner only when there is one — the
// shared failure surface every tab panel opens with.
templ panelError(message string) {
	if message != "" {
		@errorBanner(message)
	}
}

// identityLine is the one home of the from-identity line the composer
// panels render when the deployment knows the extension's DID.
templ identityLine(lang Lang, identity string) {
	if identity != "" {
		<p class="wp-identity">{ T(lang, "identity.from") } <strong>{ identity }</strong></p>
	}
}

// sendIndicator is the ONE home of the submit-button htmx spinner (the
// request in-flight marker htmx toggles on .htmx-request forms); Button
// renders it ahead of the label. Every long-running htmx form submit
// passes it in the Button's Icon slot — a click must always answer.
templ sendIndicator() {
	<span class="htmx-indicator" aria-hidden="true">…</span>
}

// headExtras applies the theme BEFORE anything paints (render-blocking,
// same-origin — the CSP allows no inline scripts), loads htmx deferred —
// AFTER the htmx-config meta, so htmx sees it at startup and skips its
// CSP-hostile inline indicator styles — then the SSE + idiomorph
// extension bundle in ONE request (cqrshtmx.HTMXExtensionsHandler behind
// /htmx-ext.js), the island stylesheet (after app.css so its element
// rules win), and the tiny shell script that tracks the active nav item
// across partial swaps.
templ headExtras(csrfToken string) {
	// M19: layout.Base hardcodes `width=device-width, initial-scale=1.0`
	// and offers no viewport prop. A second viewport meta MERGES with the
	// first per the CSS Viewport spec (keys are combined in document
	// order), so this adds `interactive-widget=resizes-content` for
	// Chromium — the on-screen keyboard resizes the LAYOUT viewport, so
	// the sticky composer stays above the keyboard instead of hiding
	// under it. Browsers without the key ignore it (no fork of Base).
	<meta name="viewport" content="interactive-widget=resizes-content"></meta>
	<script src="/assets/theme-preload.js"></script>
	<link rel="manifest" href="/manifest.webmanifest"></link>
	// Warm the island's script payloads from the head: the ESM graph
	// (modulepreload — fetch AND compile while the body still parses; the
	// entry tag sits at the end of body) and the one big classic script
	// (sip.min.js, discovered just as late without this hint). The graph
	// list is generated from the embedded files, so it can never drift.
	for _, module := range assets.IslandModules() {
		<link rel="modulepreload" href={ module }></link>
	}
	<link rel="preload" as="script" href="/assets/vendor/sip.min.js"></link>
	<meta name="csrf-token" content={ csrfToken }></meta>
	<meta
		name="htmx-config"
		content='{"includeIndicatorStyles":false,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"401","swap":false,"error":true},{"code":"[45]..","swap":true,"error":true,"target":"#wp-tab-error","select":".wp-error"}]}'
	></meta>
	<script src="/htmx.min.js" defer></script>
	<script src="/htmx-ext.js" defer></script>
	<link rel="stylesheet" href="/assets/island/style.css"></link>
	<link rel="stylesheet" href="/assets/tw.css"></link>
	<script src="/assets/shell.js" defer></script>
}

// bodyAttrs wires CSRF into every HTMX request. The value is raw JSON:
// templ HTML-escapes the attribute exactly once on render, so using the
// pre-escaped httputil helper here would double-escape and break hx-headers
// parsing (dropping CSRF protection from every HTMX request).
func bodyAttrs(props ShellProps) templ.Attributes {
	return templ.Attributes{
		"hx-headers": props.CSRFHxHeaders,
	}
}

// SignInHint fills the tab region while nobody is signed in: a short
// product story plus the one action that unlocks everything (signing in
// on the phone panel to the left).
templ SignInHint(lang Lang) {
	<section class="wp-panel wp-welcome">
		<h2 class="wp-welcome-title">{ T(lang, "welcome.title") }</h2>
		<p class="wp-welcome-body">{ T(lang, "welcome.body") }</p>
		<ul class="wp-welcome-points">
			<li>{ T(lang, "welcome.point1") }</li>
			<li>{ T(lang, "welcome.point2") }</li>
			<li>{ T(lang, "welcome.point3") }</li>
		</ul>
		<p class="wp-welcome-hint">{ T(lang, "signin.hint") }</p>
		<p class="wp-welcome-compact-line">{ T(lang, "welcome.compact") }</p>
		<button type="button" class="wp-mini wp-welcome-dismiss">{ T(lang, "welcome.dismiss") }</button>
	</section>
}

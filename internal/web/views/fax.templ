package views

import (
	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/forms"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/utils"
	"github.com/larsartmann/webphone/internal/domain"
)

// FaxCapability is what THIS deployment can actually do with fax, per
// direction (mirrored from config.Fax by the server). The directions are
// independent: a PBX that receives faxes on a dedicated number but has no
// outbound provider is the common case. The zero value (both false) means
// no fax lane at all — the panel then says so up front instead of offering
// a form that can only fail, and the zero-config product (both true)
// renders byte-identically to the pre-capability markup.
type FaxCapability struct {
	Send    bool
	Receive bool
}

// Any reports whether any direction is available.
func (c FaxCapability) Any() bool { return c.Send || c.Receive }

// FaxPanel is the Fax tab: PDF upload form plus the job list (outbox and
// inbox). Only the list region carries sse-swap="fax" so live pushes
// never wipe a PDF half-selected into the upload form.
type FaxPanelProps struct {
	Jobs  []domain.FaxJob
	Error string
	// Capability gates every affordance: no send → no form, no receive →
	// the panel says the list can only ever hold what was sent.
	Capability FaxCapability
	// Identity is the extension's presented number (DID); empty = unknown.
	Identity string
	// CRM carries the optional CRM integration's answers for the numbers
	// this panel renders (name + deep link); an absent number renders raw.
	CRM CRMContacts
	Lang  Lang
}

templ FaxPanel(props FaxPanelProps) {
	<section class="wp-panel" id="fax-panel">
		@panelHead(props.Lang, "tab.fax", faxSubtitleKey(props.Capability))
		@panelError(props.Error)
		@identityLine(props.Lang, props.Identity)
		if props.Capability.Send {
			<form
				class="wp-compose wp-compose-fax"
				hx-post="/fax/send"
				hx-target="#tab-content"
				hx-swap="innerHTML"
				hx-encoding="multipart/form-data"
				enctype="multipart/form-data"
				hx-disabled-elt="find button[type=submit]"
			>
				@forms.Input(forms.InputProps{
					BaseProps: utils.BaseProps{
						AriaLabel: T(props.Lang, "fax.number.ph"),
						Attrs:     templ.Attributes{"inputmode": "tel"},
					},
					Name:        "to",
					Placeholder: T(props.Lang, "fax.number.ph"),
					Required:    true,
				})
				<input type="file" name="document" required accept="application/pdf,.pdf" aria-label={ T(props.Lang, "fax.document.label") }></input>
				@display.Button(display.ButtonProps{
					Type:  display.ButtonHTMLSubmit,
					Icon:  faxSendIndicator(),
					Text:  T(props.Lang, "fax.send"),
				})
				<div class="wp-attach" hidden></div>
			</form>
		} else {
			@faxUnavailableNotice(props.Lang, faxUnavailableKey(props.Capability))
		}
		if !props.Capability.Receive && props.Capability.Send {
			@faxUnavailableNotice(props.Lang, "fax.receiveOff")
		}
		<div class="wp-fax-list" sse-swap="fax" hx-swap="morph:innerHTML">
			@FaxList(props.Jobs, props.CRM, props.Capability, props.Lang)
		</div>
	</section>
}

// faxSubtitleKey picks the panel subtitle: the plain one only when BOTH
// directions exist (byte-identical default), otherwise a line that states
// which half is missing. One home for the mapping.
func faxSubtitleKey(cap FaxCapability) string {
	switch {
	case cap.Send && cap.Receive:
		return "fax.subtitle"
	case cap.Send:
		return "fax.subtitle.noreceive"
	case cap.Receive:
		return "fax.subtitle.nosend"
	default:
		return "fax.subtitle.off"
	}
}

// faxUnavailableKey picks the notice body for a half (or wholly) missing
// lane. The "no send, no receive" case has its own combined copy so the
// panel never stacks two notices saying almost the same thing.
func faxUnavailableKey(cap FaxCapability) string {
	switch {
	case !cap.Send && !cap.Receive:
		return "fax.off"
	case !cap.Send:
		return "fax.sendOff"
	default:
		return "fax.receiveOff"
	}
}

// faxUnavailableNotice is the panel's honest "this cannot work here" box:
// styled as the informational empty state (never as an error — nothing
// broke, a capability is absent) and marked with wp-fax-off so the smoke
// and UI-capture harnesses can assert which state rendered.
templ faxUnavailableNotice(lang Lang, key string) {
	<p class="wp-empty wp-fax-off" role="note">{ T(lang, key) }</p>
}


// faxSendIndicator is the send button's htmx spinner (the request
// in-flight marker); Button renders it ahead of the label.
templ faxSendIndicator() {
	<span class="htmx-indicator" aria-hidden="true">…</span>
}

// FaxList renders the fax rows (or the empty state). It is the payload of
// the SSE "fax" event, so it must stay swap-safe: no wrapper, no form. The
// empty state names the capability because "send a PDF above" is a lie
// when the send form is absent — and an SSE payload must agree with the
// full render (the Notifier carries the same boot-time flags).
templ FaxList(jobs []domain.FaxJob, contacts CRMContacts, cap FaxCapability, lang Lang) {
	if len(jobs) == 0 {
		@display.EmptyState(display.EmptyStateProps{Title: T(lang, faxEmptyKey(cap)), Icon: icons.Document})
	}
	for _, job := range jobs {
		@FaxRow(job, contacts, lang)
	}
}

// faxEmptyKey is the one home of the empty-state copy mapping.
func faxEmptyKey(cap FaxCapability) string {
	switch {
	case cap.Send && cap.Receive:
		return "fax.empty"
	case cap.Send:
		return "fax.empty.noreceive"
	case cap.Receive:
		return "fax.empty.nosend"
	default:
		return "fax.empty.off"
	}
}


templ FaxRow(job domain.FaxJob, contacts CRMContacts, lang Lang) {
	// wp-fax-row stays in the class list: it is the swap-safety contract
	// the SSE fax-payload test greps for (TestSSEPushesSwapSafeFragments).
	<article class={ "wp-row wp-fax-row", templ.KV("wp-fax-in", job.Direction == domain.FaxInbound) }>
		<span class={ "wp-dir-chip", templ.KV("wp-dir-in", job.Direction == domain.FaxInbound) } aria-hidden="true">{ faxDirGlyph(job) }</span>
		<span class="wp-thread-text" role="img" aria-label={ faxDirLabel(job, lang) }>
			@remoteLabel(job.Remote.String(), contacts, lang)
			<span class="wp-muted">
				{ formatStamp(lang, job.CreatedAt) }
				{ " " }
				@FaxStatusBadge(job, lang)
				if job.Pages > 0 {
					{ " · " + fmtInt(job.Pages) + T(lang, "fax.pages") }
				}
				if job.Error != "" {
					<span class="wp-error" role="alert">{ job.Error }</span>
				}
			</span>
			if job.Direction == domain.FaxOutbound {
				@FaxSteps(job, lang)
			}
		</span>
		<span class="wp-row-actions">
			if job.Direction == domain.FaxOutbound && job.Status == domain.FaxFailed {
				<button
					class="wp-mini"
					hx-post={ "/fax/" + job.ID.String() + "/resend" }
					hx-target="#tab-content"
					hx-swap="innerHTML"
				>{ T(lang, "fax.resend") }</button>
			}
			if job.DocumentPath != "" {
				<a class="wp-mini" href={ "/fax/" + job.ID.String() + "/document" } download>{ T(lang, "fax.pdf") }</a>
			}
		</span>
	</article>
}

func faxDirGlyph(job domain.FaxJob) string {
	if job.Direction == domain.FaxInbound {
		return "↓"
	}
	return "↑"
}

func faxDirLabel(job domain.FaxJob, lang Lang) string {
	if job.Direction == domain.FaxInbound {
		return T(lang, "fax.in")
	}
	return T(lang, "fax.out")
}

templ FaxStatusBadge(job domain.FaxJob, lang Lang) {
	<span class={ "wp-status", faxStatusClass(job.Status) }>{ faxStatusText(job.Status, lang) }</span>
}

// FaxSteps renders the outbound progress timeline (queued → sending →
// delivered, or the failed stop). Decoration only (aria-hidden): the
// status badge beside it carries the textual truth in the session's
// language; the title adds the last transition time for pointer users.
templ FaxSteps(job domain.FaxJob, lang Lang) {
	<span
		class={ "wp-fax-steps", "wp-steps-" + faxStepState(job.Status) }
		aria-hidden="true"
		title={ faxStatusText(job.Status, lang) + " · " + formatStamp(lang, job.UpdatedAt) }
	>
		<span class="wp-step"></span>
		<span class="wp-step"></span>
		<span class="wp-step"></span>
	</span>
}

// faxStatusText is the one home of the status→copy mapping (badge and
// steps title share it).
func faxStatusText(status domain.FaxStatus, lang Lang) string {
	switch status {
	case domain.FaxQueued:
		return T(lang, "status.queued")
	case domain.FaxSending:
		return T(lang, "status.sending")
	case domain.FaxTransmitted:
		return T(lang, "status.transmitted")
	case domain.FaxReceived:
		return T(lang, "status.received")
	case domain.FaxFailed:
		return T(lang, "status.failed")
	default:
		return string(status)
	}
}

func faxStatusClass(status domain.FaxStatus) string {
	switch status {
	case domain.FaxQueued, domain.FaxSending:
		return "wp-status-queued"
	case domain.FaxTransmitted, domain.FaxReceived:
		return "wp-status-sent"
	case domain.FaxFailed:
		return "wp-status-failed"
	default:
		return ""
	}
}

// faxStepState maps a status onto the timeline position: 1 = queued,
// 2 = sending, failed = struck in flight (danger styling), done =
// delivered. Inbound rows never render steps.
func faxStepState(status domain.FaxStatus) string {
	switch status {
	case domain.FaxQueued:
		return "1"
	case domain.FaxSending:
		return "2"
	case domain.FaxFailed:
		return "failed"
	case domain.FaxTransmitted:
		return "done"
	default:
		return "1"
	}
}

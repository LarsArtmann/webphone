package views

import "github.com/larsartmann/webphone/internal/domain"

// ContactsPanel merges per-extension personal contacts (stored on this
// server) with operator-provided shared contacts (from config). The dial
// button pushes the number into the island's dial field via shell.js.
type ContactsPanelProps struct {
	Personal []domain.Contact
	Shared   []domain.SharedContact
}

templ ContactsPanel(props ContactsPanelProps) {
	<section class="wp-panel" id="contacts-panel">
		<header class="wp-panel-head">
			<h2>Contacts</h2>
			<p class="wp-panel-sub">Your contacts, stored on this server, plus shared ones.</p>
		</header>
		<form
			class="wp-compose wp-compose-new"
			hx-post="/contacts/save"
			hx-target="#tab-content"
			hx-swap="innerHTML"
		>
			<input name="name" required placeholder="Name" aria-label="Contact name"/>
			<input name="number" inputmode="tel" required placeholder="Number" aria-label="Contact number"/>
			<button type="submit" class="wp-primary">Save</button>
		</form>
		if len(props.Personal) == 0 && len(props.Shared) == 0 {
			<p class="wp-empty">No contacts yet — add one above.</p>
		}
		for _, contact := range props.Personal {
			<article class="wp-fax-row">
				<strong class="wp-thread-remote">{ contact.Name }</strong>
				<span class="wp-muted">{ contact.Phone.String() }</span>
				<button class="wp-primary" data-dial={ contact.Phone.String() }>Call</button>
				<button
					class="wp-danger"
					hx-post={ "/contacts/delete?id=" + contact.ID.String() }
					hx-target="#tab-content"
					hx-swap="innerHTML"
					hx-confirm="Remove this contact?"
				>Remove</button>
			</article>
		}
		for _, contact := range props.Shared {
			<article class="wp-fax-row">
				<strong class="wp-thread-remote">{ contact.Name }</strong>
				<span class="wp-muted">{ contact.Number }</span>
				<span class="wp-shared-tag">shared</span>
				<button class="wp-primary" data-dial={ contact.Number }>Call</button>
			</article>
		}
	</section>
}

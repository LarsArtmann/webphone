package views

import (
	"strings"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/webphone/internal/domain"
)

// ContactsPanel merges per-extension personal contacts (stored on this
// server) with operator-provided shared contacts (from config). The dial
// button pushes the number into the island's dial field via shell.js.
type ContactsPanelProps struct {
	Personal []domain.Contact
	Shared   []domain.SharedContact
	// Query is the active contact-search filter ("" = unfiltered); the
	// search input echoes it so a morph swap keeps the typed text.
	Query string
	Lang  Lang
}

templ ContactsPanel(props ContactsPanelProps) {
	<section
		class="wp-panel"
		id="contacts-panel"
		hx-get="/partials/contacts"
		hx-trigger="sse:contacts"
		hx-target="#tab-content"
		hx-swap="morph:innerHTML show:window:top"
	>
		@panelHead(props.Lang, "tab.contacts", "contacts.subtitle")
		// The search form filters server-side; htmx morph keeps the
		// input's focus across debounced re-fetches (stable id below),
		// and the shell.js SSE guard cancels live nudges while a query
		// is set (same contract as the thread search).
		<form
			class="wp-compose wp-compose-search"
			role="search"
			aria-label={ T(props.Lang, "contacts.search") }
			hx-get="/partials/contacts"
			hx-target="#tab-content"
			hx-swap="morph:innerHTML"
			hx-trigger="input changed delay:300ms, submit"
			hx-sync="this:replace"
		>
			<input
				type="search"
				name="q"
				id="contact-search-input"
				value={ props.Query }
				placeholder={ T(props.Lang, "contacts.search.ph") }
				aria-label={ T(props.Lang, "contacts.search") }
			></input>
		</form>
		<form
			class="wp-compose wp-compose-new"
			hx-post="/contacts/save"
			hx-target="#tab-content"
			hx-swap="innerHTML"
		>
			<input id="contact-name-input" name="name" required placeholder={ T(props.Lang, "contacts.name.ph") } aria-label={ T(props.Lang, "contacts.name.label") }/>
			<input id="contact-number-input" name="number" inputmode="tel" required placeholder={ T(props.Lang, "contacts.number.ph") } aria-label={ T(props.Lang, "contacts.number.label") }/>
			<button type="submit" class="wp-primary">{ T(props.Lang, "contacts.save") }</button>
		</form>
		<div class="wp-compose">
			<form
				class="wp-compose"
				hx-post="/contacts/import"
				hx-target="#tab-content"
				hx-swap="innerHTML"
				hx-encoding="multipart/form-data"
			>
				<input id="contact-import-file" type="file" name="vcard" accept=".vcf,text/vcard" required aria-label={ T(props.Lang, "contacts.importFile.label") }/>
				<button type="submit">{ T(props.Lang, "contacts.import") }</button>
			</form>
			<a class="wp-export-link" href="/contacts/export">{ T(props.Lang, "contacts.export") }</a>
		</div>
		if len(props.Personal) == 0 && len(props.Shared) == 0 {
			@display.EmptyState(display.EmptyStateProps{Title: T(props.Lang, "contacts.empty"), Icon: icons.Users})
		}
		if props.Query != "" && len(props.Personal) == 0 && len(props.Shared) > 0 {
			// A filtered view that matches only shared contacts says so
			// instead of looking like the personal list vanished.
			<p class="wp-muted">{ T(props.Lang, "contacts.noPersonalMatch") }</p>
		}
		for i, contact := range props.Personal {
			if i == 0 || letterOf(props.Personal[i-1].Name) != letterOf(contact.Name) {
				<div class="wp-letter-head" aria-hidden="true">{ letterOf(contact.Name) }</div>
			}
			@ContactRow(contact, props.Lang)
		}
		if len(props.Shared) > 0 {
			<div class="wp-letter-head">{ T(props.Lang, "contacts.sharedHead") }</div>
		}
		for _, contact := range props.Shared {
			<article class="wp-row">
				<span class={ "wp-avatar", "wp-avatar-shared", avatarHueClass(contact.Name+contact.Number) } aria-hidden="true">{ avatarFor(contact.Name) }</span>
				<span class="wp-thread-text">
					<strong class="wp-thread-remote">{ contact.Name }</strong>
					<span class="wp-muted">{ contact.Number }</span>
				</span>
				<span class="wp-shared-tag">{ T(props.Lang, "contacts.shared") }</span>
				<span class="wp-row-actions">
					<button class="wp-mini" data-dial={ contact.Number }>{ T(props.Lang, "contacts.call") }</button>
				</span>
			</article>
		}
	</section>
}

templ ContactRow(contact domain.Contact, lang Lang) {
	<article class="wp-row">
		<span class={ "wp-avatar", avatarHueClass(contact.Name+contact.Phone.String()) } aria-hidden="true">{ avatarFor(contact.Name) }</span>
		<span class="wp-thread-text">
			<strong class="wp-thread-remote">{ contact.Name }</strong>
			<span class="wp-muted">{ contact.Phone.String() }</span>
		</span>
		<span class="wp-row-actions">
			<button class="wp-mini" data-dial={ contact.Phone.String() }>{ T(lang, "contacts.call") }</button>
			// Edit prefills the save form (the store upserts by number
			// and keeps the id on rename, so saving IS editing).
			<button
				class="wp-mini"
				data-edit-name={ contact.Name }
				data-edit-number={ contact.Phone.String() }
				aria-label={ T(lang, "contacts.edit") }
				title={ T(lang, "contacts.edit") }
			>✎</button>
			<a
				class="wp-mini"
				href={ "/contacts/" + contact.ID.String() + "/export" }
				download
				aria-label={ T(lang, "contacts.vcard") }
				title={ T(lang, "contacts.vcard") }
			>vCard</a>
			<button
				class="wp-mini wp-danger"
				hx-post={ "/contacts/delete?id=" + contact.ID.String() }
				hx-target="#tab-content"
				hx-swap="innerHTML"
				hx-confirm={ T(lang, "contacts.removeConfirm") }
			>{ T(lang, "contacts.remove") }</button>
		</span>
	</article>
}

// letterOf buckets a contact by the uppercase first rune of its name for
// the alphabetical section heads; a blank name lands under "#".
func letterOf(name string) string {
	trimmed := strings.TrimSpace(name)
	if trimmed == "" {
		return "#"
	}
	return strings.ToUpper(string([]rune(trimmed)[0]))
}

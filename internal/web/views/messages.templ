package views

import (
	"strings"
	"time"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/webphone/internal/domain"
	"github.com/larsartmann/webphone/internal/store"
)

// ThreadsPanel is the Messages tab's landing view: the thread list plus a
// composer for new conversations. Only the list region carries
// sse-swap="threads" — a live push refreshes the rows without wiping a
// draft half-typed into the composer.
type ThreadsPanelProps struct {
	Threads []store.ThreadSummary
	// Query is the active thread-search filter ("" = unfiltered list);
	// the search input echoes it so a morph swap keeps the typed text.
	Query string
	// Archived switches the panel to the archived-threads view (design
	// D6); ArchivedCount feeds the toggle link when in the active view.
	Archived      bool
	ArchivedCount int
	Error         string
	// Identity is the extension's presented number (DID); empty = unknown.
	Identity string
	// Names maps phone numbers to CRM contact names (optional integration);
	// unresolved numbers render verbatim.
	Names map[string]string
	Lang  Lang
}

templ ThreadsPanel(props ThreadsPanelProps) {
	<section class="wp-panel" id="messages-panel">
		@panelHead(props.Lang, "tab.messages", "messages.subtitle")
		@panelError(props.Error)
		// The search form lives OUTSIDE the sse-swap region so live list
		// pushes never re-render it; htmx morph keeps the input's focus
		// across debounced re-fetches (stable id below). The archived view
		// hides it (design D6): search walks the ACTIVE list only, so a
		// box there would look broken, not filtered.
		if !props.Archived {
			<form
				class="wp-thread-search"
				role="search"
				aria-label={ T(props.Lang, "threads.search") }
				hx-get="/partials/messages"
				hx-target="#tab-content"
				hx-swap="morph:innerHTML"
				hx-trigger="input changed delay:300ms, submit"
				hx-sync="this:replace"
			>
				<input
					type="search"
					name="q"
					id="wp-thread-search-input"
					value={ props.Query }
					placeholder={ T(props.Lang, "threads.search.ph") }
					aria-label={ T(props.Lang, "threads.search.label") }
				></input>
			</form>
		}
		// The archived toggle (design D6): only rendered when there is
		// something archived — or when the archived view is open and the
		// way back is needed. Deep links work: the panel route reads the
		// same query param full renders do.
		if props.Archived {
			<a
				class="wp-archived-toggle"
				href="/messages"
				hx-get="/partials/messages"
				hx-target="#tab-content"
				hx-swap="innerHTML"
				hx-push-url="/messages"
			>← { T(props.Lang, "threads.back") }</a>
		} else if props.ArchivedCount > 0 {
			<a
				class="wp-archived-toggle"
				href={ "/messages?archived=1" }
				hx-get="/partials/messages?archived=1"
				hx-target="#tab-content"
				hx-swap="innerHTML"
				hx-push-url="/messages?archived=1"
			>{ T(props.Lang, "threads.archived") } ({ fmtInt(props.ArchivedCount) })</a>
		}
		<div class="wp-thread-list" sse-swap="threads" hx-swap="morph:innerHTML">
			if props.Query != "" && len(props.Threads) == 0 {
				@display.EmptyState(display.EmptyStateProps{
					Title: T(props.Lang, "threads.noMatch.pre") + "“" + props.Query + "”" + T(props.Lang, "threads.noMatch.post"),
					Icon:  icons.Search,
				})
			} else {
				@ThreadsList(props.Threads, props.Names, props.Lang)
			}
		</div>
		@identityLine(props.Lang, props.Identity)
		@NewMessageForm("", props.Lang)
	</section>
}

// ThreadsList renders the thread rows (or the empty state). It is the
// payload of the SSE "threads" event, so it must stay swap-safe: no
// wrapper element, no composer.
templ ThreadsList(threads []store.ThreadSummary, names map[string]string, lang Lang) {
	if len(threads) == 0 {
		@display.EmptyState(display.EmptyStateProps{Title: T(lang, "threads.empty"), Icon: icons.Inbox})
	}
	for _, summary := range threads {
		@ThreadRow(summary, names, lang)
	}
}

templ ThreadRow(summary store.ThreadSummary, names map[string]string, lang Lang) {
	// The wrapper carries the STABLE id (design D14): idiomorph persists
	// nodes by id, and the row grows stateful flag buttons (M22) — without
	// the id a live push could rebuild the row mid-click.
	<div class="wp-thread-rowwrap" id={ "thread-" + summary.Thread.ID.String() }>
		<a
			class={ "wp-thread-row", templ.KV("wp-unread", summary.Thread.Unread > 0 && !summary.Thread.Muted), templ.KV("wp-pinned", summary.Thread.Pinned) }
			href={ "/messages/" + summary.Thread.ID.String() }
			hx-get={ "/partials/messages/" + summary.Thread.ID.String() }
			hx-target="#tab-content"
			hx-swap="innerHTML show:window:top"
			hx-push-url={ "/messages/" + summary.Thread.ID.String() }
		>
			<span class={ "wp-avatar", avatarHueClass(summary.Thread.Remote.String()) } aria-hidden="true">{ avatarFor(displayName(summary.Thread.Remote.String(), names)) }</span>
			<span class="wp-thread-text">
				<span class="wp-thread-remote">{ displayName(summary.Thread.Remote.String(), names) }</span>
				<span class="wp-thread-preview">{ threadPreview(summary, lang) }</span>
			</span>
			<span class="wp-thread-side">
				<span
					class="wp-thread-when"
					title={ fullStamp(lang, summary.Thread.LastActivityAt) }
					data-when={ fmtInt(int(summary.Thread.LastActivityAt.Unix())) }
				>{ relativeTime(summary.Thread.LastActivityAt, lang) }</span>
				// Mute suppresses the badge, never the count (design D8): the
				// muted row shows the speaker-off glyph instead.
				if summary.Thread.Unread > 0 && !summary.Thread.Muted {
					<span class="wp-nav-badge" aria-label={ badgeCount(lang, summary.Thread.Unread, "nav.unread") }>{ fmtInt(summary.Thread.Unread) }</span>
				}
			</span>
		</a>
		<button
			class="wp-mini"
			data-dial={ summary.Thread.Remote.String() }
			aria-label={ T(lang, "contacts.call") }
			title={ T(lang, "contacts.call") }
		>📞</button>
		// Organization flags (M22): each button posts the DESIRED state
		// (the row renders the flip of its current state). The archived
		// view offers only the way back — the filing cabinet keeps no pins.
		if summary.Thread.Archived {
			@threadFlagButton(summary.Thread.ID, "archive", T(lang, "threads.unarchive"), "📥", 0)
		} else {
			@threadFlagButton(summary.Thread.ID, "pin", flagLabel(lang, !summary.Thread.Pinned, "threads.pin", "threads.unpin"), "📌", wantInt(!summary.Thread.Pinned))
			@threadFlagButton(summary.Thread.ID, "mute", flagLabel(lang, !summary.Thread.Muted, "threads.mute", "threads.unmute"), muteGlyph(summary.Thread.Muted), wantInt(!summary.Thread.Muted))
			@threadFlagButton(summary.Thread.ID, "archive", T(lang, "threads.archive"), "📥", 1)
		}
	</div>
}

// threadFlagButton posts one organization toggle (M22). on is the
// DESIRED state; the SSE threads nudge re-renders the list, so the
// button itself swaps nothing (hx-swap none, 204 by responseHandling).
templ threadFlagButton(id domain.ThreadID, flag, labelKey, glyph string, on int) {
	<button
		type="button"
		class="wp-mini wp-thread-flag"
		aria-label={ labelKey }
		title={ labelKey }
		hx-post={ flagURL(id, flag, on) }
		hx-swap="none"
	>{ glyph }</button>
}

// headFlagButton is threadFlagButton aimed at the head itself (M22): a
// head toggle swaps the header outerHTML — the response is the freshly
// rendered head with the confirmed state — while the transcript, the
// scroll place and any reply draft stay untouched. The row variant
// (above) swaps nothing and rides the SSE list nudge instead.
templ headFlagButton(id domain.ThreadID, flag, labelKey, glyph string, on int) {
	<button
		type="button"
		class="wp-mini wp-thread-flag"
		aria-label={ labelKey }
		title={ labelKey }
		hx-post={ flagURL(id, flag, on) }
		hx-target="#wp-thread-head"
		hx-swap="outerHTML"
	>{ glyph }</button>
}

// ThreadHead is the open conversation's header: the way back, the
// remote's name, the organization toggles (M22) and the dial affordance.
// Its own component because a head toggle re-renders EXACTLY this
// fragment — setThreadFlag answers an #wp-thread-head-targeted post
// with the fresh head, so the buttons flip to the state the network
// confirmed (island honesty contract) without disturbing anything else.
templ ThreadHead(props ThreadViewProps) {
	<header class="wp-panel-head wp-thread-head" id="wp-thread-head">
		<a
			class="wp-back"
			href="/messages"
			hx-get="/partials/messages"
			hx-target="#tab-content"
			hx-swap="innerHTML show:window:top"
			hx-push-url="/messages"
		>← All messages</a>
		<h2>{ displayName(props.Thread.Remote.String(), props.Names) }</h2>
		if props.Thread.Archived {
			@headFlagButton(props.Thread.ID, "archive", T(props.Lang, "threads.unarchive"), "📥", 0)
		} else {
			@headFlagButton(props.Thread.ID, "pin", flagLabel(props.Lang, !props.Thread.Pinned, "threads.pin", "threads.unpin"), "📌", wantInt(!props.Thread.Pinned))
			@headFlagButton(props.Thread.ID, "mute", flagLabel(props.Lang, !props.Thread.Muted, "threads.mute", "threads.unmute"), muteGlyph(props.Thread.Muted), wantInt(!props.Thread.Muted))
			@headFlagButton(props.Thread.ID, "archive", T(props.Lang, "threads.archive"), "📥", 1)
		}
		<button class="wp-primary" data-dial={ props.Thread.Remote.String() }>{ T(props.Lang, "contacts.call") }</button>
	</header>
}

func flagURL(id domain.ThreadID, flag string, on int) string {
	return "/messages/" + id.String() + "/" + flag + "?on=" + fmtInt(on)
}

func wantInt(on bool) int {
	if on {
		return 1
	}
	return 0
}

func muteGlyph(muted bool) string {
	if muted {
		return "🔇"
	}
	return "🔔"
}

// flagLabel resolves a toggle's action label: the SAME state expression
// that feeds the posted value selects the key (action when the flip
// applies, its reverse otherwise), so label and desired state can never
// disagree. The glyph shows the CURRENT state; the label names the ACTION.
func flagLabel(lang Lang, state bool, action, reverse string) string {
	if state {
		return T(lang, action)
	}
	return T(lang, reverse)
}

// threadPreview is the row's last-message preview: an attachment
// prefixes the text (M21.2) so a photo thread reads as one at a glance.
func threadPreview(summary store.ThreadSummary, lang Lang) string {
	text := preview(summary.LastBody, summary.LastChannel, lang)
	if summary.LastAttachment {
		return "📎 " + text
	}
	return text
}

// NewMessageForm starts a conversation with a typed number.
templ NewMessageForm(prefillTo string, lang Lang) {
	<form
		class="wp-compose wp-compose-new"
		hx-post="/messages/send"
		hx-target="#tab-content"
		hx-swap="innerHTML"
		hx-encoding="multipart/form-data"
		enctype="multipart/form-data"
		hx-disabled-elt="find button[type=submit]"
	>
		<input
			name="to"
			inputmode="tel"
			required
			placeholder={ T(lang, "compose.to.ph") }
			aria-label={ T(lang, "compose.to.label") }
			value={ prefillTo }
		></input>
		<textarea
			name="body"
			class="wp-compose-body"
			rows="1"
			placeholder={ T(lang, "compose.body.ph") }
			aria-label={ T(lang, "compose.body.label") }
		></textarea>
		<span class="wp-segcount" hidden aria-live="polite"></span>
		<button type="submit" class="wp-primary">{ T(lang, "compose.send") }</button>
	</form>
}

// SnippetChips renders the quick-reply chips (M21): up to five quick
// snippets as one-tap fills for the reply composer. A chip carries the
// body itself (data-snippet); shell.js fills the nearest compose box —
// replace, the data-sms prefill precedent. The title holds the full
// body; the chip is the glance surface.
templ SnippetChips(snippets []domain.Snippet) {
	for _, snippet := range quickSnippets(snippets) {
		<button type="button" class="wp-chip" data-snippet={ snippet.Body } title={ snippet.Body }>{ chipLabel(snippet.Body) }</button>
	}
}

// snippetPicker lists EVERY snippet behind a disclosure (M21): the
// quick chips are the fast lane, the picker is the library.
templ snippetPicker(snippets []domain.Snippet, lang Lang) {
	<details class="wp-snippet-picker">
		<summary>{ T(lang, "snippets.insert") }</summary>
		<div class="wp-snippet-list">
			for _, snippet := range snippets {
				<button type="button" class="wp-snippet-item" data-snippet={ snippet.Body } title={ snippet.Body }>
					{ chipLabel(snippet.Body) }
					if snippet.Quick {
						<span class="wp-snippet-quick" aria-hidden="true">⚡</span>
					}
				</button>
			}
		</div>
	</details>
}

// quickSnippets picks the quick snippets, oldest first, capped at five
// (the chip lane; the picker holds the whole list).
func quickSnippets(snippets []domain.Snippet) []domain.Snippet {
	quick := make([]domain.Snippet, 0, 5)
	for _, snippet := range snippets {
		if snippet.Quick && len(quick) < 5 {
			quick = append(quick, snippet)
		}
	}
	return quick
}

// chipLabel shortens a snippet for a chip or picker row: 28 runes, then
// an ellipsis (the title and the compose fill carry the full body).
func chipLabel(body string) string {
	runes := []rune(body)
	if len(runes) <= 28 {
		return body
	}
	return string(runes[:27]) + "…"
}

// ThreadView is one open conversation: transcript and reply composer.
type ThreadViewProps struct {
	Thread   domain.Thread
	Messages []domain.Message
	Error    string
	// Page is the transcript window currently shown (0 = newest); HasMore
	// reports older pages beyond the window.
	Page    int
	HasMore bool
	// Snippets are the owner's reply snippets (M21): quick ones render
	// as chips, all of them sit behind the picker — above the REPLY
	// composer only (a new conversation never needs canned answers).
	Snippets []domain.Snippet
	// Identity is the extension's presented number (DID); empty = unknown.
	Identity string
	// Names maps phone numbers to CRM contact names (optional integration).
	Names map[string]string
	Lang  Lang
}

templ ThreadView(props ThreadViewProps) {
	<section class="wp-panel" id="messages-panel">
		@ThreadHead(props)
		@panelError(props.Error)
		if isSelfThread(props.Identity, props.Thread.Remote) {
			<p class="wp-notice" role="note">{ T(props.Lang, "thread.selfNotice") }</p>
		}
		if props.HasMore {
			<form
				class="wp-older"
				hx-get={ "/partials/messages/" + props.Thread.ID.String() + "?older=" + fmtInt(props.Page+1) }
				hx-target="#tab-content"
				hx-swap="innerHTML show:window:top"
				hx-trigger="submit"
			>
				<button type="submit">{ T(props.Lang, "thread.loadOlder") }</button>
			</form>
		}
		<div class="wp-transcript-wrap">
			<div
				class="wp-transcript"
				id="thread-transcript"
				sse-swap="thread"
				hx-swap="morph:innerHTML"
				data-page={ fmtInt(props.Page) }
				data-thread={ props.Thread.ID.String() }
			>
				if props.Page == 0 {
					// Page 0 renders the unread divider (the thread's Unread
					// was captured before the handler marked it read); older
					// pages hold no unread bubbles — a top divider there
					// would lie about where they live.
					@TranscriptAt(props.Messages, props.Lang, props.Thread.Unread)
				} else {
					@Transcript(props.Messages, props.Lang)
				}
			</div>
			<button type="button" class="wp-jump-latest" hidden aria-label="jump to the latest messages"></button>
		</div>
		@identityLine(props.Lang, props.Identity)
		<form
			class="wp-compose"
			hx-post={ "/messages/send?thread=" + props.Thread.ID.String() }
			hx-target="#tab-content"
			hx-swap="innerHTML show:window:bottom"
			hx-encoding="multipart/form-data"
			enctype="multipart/form-data"
			hx-disabled-elt="find button[type=submit]"
		>
			<input type="hidden" name="to" value={ props.Thread.Remote.String() }></input>
			// The snippet lane (M21): quick chips plus the full picker, above
			// the reply textarea and INSIDE the form so shell.js's delegated
			// data-snippet fill finds the compose box via closest(). Buttons
			// are type=button — they fill, never submit.
			if len(props.Snippets) > 0 {
				<div class="wp-snippet-bar">
					@SnippetChips(props.Snippets)
					@snippetPicker(props.Snippets, props.Lang)
				</div>
			}
			<textarea
				name="body"
				class="wp-compose-body"
				rows="1"
				placeholder={ T(props.Lang, "compose.reply.ph") }
				aria-label={ T(props.Lang, "compose.body.label") }
			></textarea>
			<input
				type="file"
				name="attachment"
				multiple
				accept="image/jpeg,image/png,image/gif,image/bmp,image/webp,image/tiff,audio/mpeg,audio/wav,audio/amr,audio/ogg,video/mp4,video/3gpp,video/quicktime,application/pdf,text/vcard,.vcf"
				aria-label="Attachments"
			></input>
			<span class="wp-segcount" hidden aria-live="polite"></span>
			<button type="submit" class="wp-primary">{ T(props.Lang, "compose.send") }</button>
			<div class="wp-attach" hidden></div>
		</form>
	</section>
}

// Transcript renders the message bubbles, oldest first, with day
// separators between calendar-day groups (Today / Yesterday / weekday +
// date, with the visible-group count). It is the payload of the SSE
// "thread" event: the swap replaces #thread-transcript's innerHTML with
// exactly these bubbles, so an open conversation updates live while the
// reply composer below stays untouched. The host div also carries
// data-page/data-thread (shell.js contract): pushes are cancelled while
// older pages are open, and a newest-page push marks the thread read
// client-side. The notifier renders this shape — the unread divider
// lives only on TranscriptAt, because a push can never know the reader's
// unread state.
templ Transcript(messages []domain.Message, lang Lang) {
	@transcriptBody(messages, lang, -1, 0)
}

// TranscriptAt is the page-0 open shape: the unread divider sits ahead
// of the thread's trailing unread inbound bubbles (Unread was captured
// before the open marked the thread read).
templ TranscriptAt(messages []domain.Message, lang Lang, unread int) {
	@transcriptBody(messages, lang, firstUnreadIndex(unread, messages), unread)
}

templ transcriptBody(messages []domain.Message, lang Lang, unreadAt, unread int) {
	for i, msg := range messages {
		if i == 0 || dayKey(messages[i-1].CreatedAt) != dayKey(msg.CreatedAt) {
			@dayHead(lang, msg.CreatedAt, dayCount(messages, i))
		}
		if i == unreadAt {
			@unreadDivider(lang, unread)
		}
		@Bubble(msg, lang)
	}
}

templ dayHead(lang Lang, at time.Time, count int) {
	<div class="wp-day-head">
		<span>{ dayHeadLabel(lang, at) }</span>
		if count > 0 {
			<span class="wp-day-count">· { fmtInt(count) }</span>
		}
	</div>
}

templ unreadDivider(lang Lang, unread int) {
	<div class="wp-unread-divider" role="separator" aria-label={ fmtInt(unread) + T(lang, "thread.unread.post") }>
		{ T(lang, "thread.unread.pre") + fmtInt(unread) + T(lang, "thread.unread.post") }
	</div>
}

templ Bubble(msg domain.Message, lang Lang) {
	<div class={ "wp-bubble", templ.KV("wp-out", msg.Direction == domain.DirectionOutbound) }>
		if msg.Body != "" {
			<p class="wp-bubble-body">{ msg.Body }</p>
		}
		for _, att := range msg.Attachments {
			// Image attachments render inline (CSS-scaled, lazy — the
			// browser fetches the full blob; server-side thumbnails are
			// deliberately deferred until payload sizes say otherwise).
			if strings.HasPrefix(att.MimeType, "image/") {
				<a class="wp-attachment wp-attachment-image" data-lightbox={ att.Name } href={ "/attachments/" + att.ID.String() } download={ att.Name }>
					<img
						class="wp-thumb"
						src={ "/attachments/" + att.ID.String() }
						alt={ att.Name }
						loading="lazy"
					/>
					<span class="wp-muted">📎 { att.Name } ({ fmtInt(int(att.SizeBytes>>10)) } KiB)</span>
				</a>
			} else {
				<a class="wp-attachment" href={ "/attachments/" + att.ID.String() } download={ att.Name }>
					📎 { att.Name } <span class="wp-muted">({ fmtInt(int(att.SizeBytes>>10)) } KiB)</span>
				</a>
			}
		}
		<span class="wp-bubble-meta">
			<span title={ fullStamp(lang, msg.CreatedAt) }>{ formatClock(lang, msg.CreatedAt) }</span>
			if msg.Direction == domain.DirectionOutbound {
				@OutboundStatusBadge(msg.Status, lang)
			}
		</span>
		if msg.Direction == domain.DirectionOutbound && msg.Status == domain.StatusFailed {
			if msg.FailureDetail != "" {
				<p class="wp-failed-detail">{ msg.FailureDetail }</p>
			}
			if msg.FailureKind == "transient" {
				<form
					class="wp-retry"
					hx-post="/messages/send"
					hx-target="#tab-content"
					hx-swap="innerHTML show:window:bottom"
					hx-encoding="multipart/form-data"
					hx-disabled-elt="find button[type=submit]"
				>
					<input type="hidden" name="to" value={ msg.Remote.String() }></input>
					<input type="hidden" name="body" value={ msg.Body }></input>
					<button type="submit" class="wp-mini">{ T(lang, "retry") }</button>
				</form>
			}
		}
	</div>
}

templ OutboundStatusBadge(status domain.OutboundStatus, lang Lang) {
	switch status {
	case domain.StatusQueued:
		<span class="wp-status wp-status-queued">{ T(lang, "status.sending") }</span>
	case domain.StatusSent:
		<span class="wp-status wp-status-sent">{ T(lang, "status.sent") }</span>
	case domain.StatusDelivered:
		<span class="wp-status wp-status-delivered"><span aria-hidden="true">✓ </span>{ T(lang, "status.delivered") }</span>
	case domain.StatusFailed:
		<span class="wp-status wp-status-failed">{ T(lang, "status.failed") }</span>
	default:
		<span></span>
	}
}

func preview(body string, channel domain.Channel, lang Lang) string {
	if channel == domain.ChannelMMS && body == "" {
		return T(lang, "media.preview")
	}
	if body == "" {
		return T(lang, "preview.empty")
	}
	return body
}

func relativeTime(t time.Time, lang Lang) string {
	delta := time.Since(t)
	switch {
	case delta < time.Minute:
		return "now"
	case delta < time.Hour:
		return fmtInt(int(delta.Minutes())) + "m"
	case delta < 24*time.Hour:
		return fmtInt(int(delta.Hours())) + "h"
	default:
		return formatStamp(lang, t)
	}
}

// dayKey buckets a timestamp by its local calendar day — the group
// boundary the transcript separators follow.
func dayKey(t time.Time) string { return t.Local().Format("2006-01-02") }

// dayCount counts the visible bubbles in the day group starting at
// start (the rendered-window count the day header shows).
func dayCount(messages []domain.Message, start int) int {
	count := 0
	for i := start; i < len(messages) && dayKey(messages[i].CreatedAt) == dayKey(messages[start].CreatedAt); i++ {
		count++
	}
	return count
}

// firstUnreadIndex locates the first of the thread's trailing unread
// inbound bubbles in the window (walking back from the newest end,
// exactly Unread inbound messages are unread). More unread than the
// window holds means they start above it — the divider lands at the top.
func firstUnreadIndex(unread int, messages []domain.Message) int {
	if unread <= 0 {
		return -1
	}
	seen := 0
	for i := len(messages) - 1; i >= 0; i-- {
		if messages[i].Direction != domain.DirectionInbound {
			continue
		}
		seen++
		if seen == unread {
			return i
		}
	}
	return 0
}

// weekdayLabel renders an abbreviated weekday in the panel language;
// Go's Format carries no localized names, so the two UI languages keep
// tiny maps (same shape as formatFor).
func weekdayLabel(lang Lang, d time.Weekday) string {
	if lang == LangDE {
		return [...]string{"So", "Mo", "Di", "Mi", "Do", "Fr", "Sa"}[d]
	}
	return [...]string{"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"}[d]
}

// dayHeadLabel names a calendar day for the transcript separators:
// Today / Yesterday in the panel language, then weekday + numeric date.
func dayHeadLabel(lang Lang, t time.Time) string {
	local := t.Local()
	now := time.Now()
	today := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, now.Location())
	day := time.Date(local.Year(), local.Month(), local.Day(), 0, 0, 0, 0, local.Location())
	days := int(today.Sub(day).Hours() / 24)
	switch {
	case days <= 0:
		return T(lang, "day.today")
	case days == 1:
		return T(lang, "day.yesterday")
	default:
		return weekdayLabel(lang, local.Weekday()) + ", " + formatFor(lang, local, "02.01.", "Jan 2")
	}
}

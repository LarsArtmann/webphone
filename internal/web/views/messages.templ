package views

import (
	"time"

	"github.com/larsartmann/webphone/internal/domain"
	"github.com/larsartmann/webphone/internal/store"
)

// ThreadsPanel is the Messages tab's landing view: the thread list plus a
// composer for new conversations. Only the list region carries
// sse-swap="threads" — a live push refreshes the rows without wiping a
// draft half-typed into the composer.
type ThreadsPanelProps struct {
	Threads []store.ThreadSummary
	Error   string
	// Identity is the extension's presented number (DID); empty = unknown.
	Identity string
	Lang     Lang
}

templ ThreadsPanel(props ThreadsPanelProps) {
	<section class="wp-panel" id="messages-panel">
		<header class="wp-panel-head">
			<h2>{ T(props.Lang, "tab.messages") }</h2>
			<p class="wp-panel-sub">{ T(props.Lang, "messages.subtitle") }</p>
		</header>
		if props.Error != "" {
			<p class="wp-error" role="alert">{ props.Error }</p>
		}
		<div class="wp-thread-list" sse-swap="threads" hx-swap="morph:innerHTML">
			@ThreadsList(props.Threads, props.Lang)
		</div>
		if props.Identity != "" {
			<p class="wp-identity">{ T(props.Lang, "identity.from") } <strong>{ props.Identity }</strong></p>
		}
		@NewMessageForm("", props.Lang)
	</section>
}

// ThreadsList renders the thread rows (or the empty state). It is the
// payload of the SSE "threads" event, so it must stay swap-safe: no
// wrapper element, no composer.
templ ThreadsList(threads []store.ThreadSummary, lang Lang) {
	if len(threads) == 0 {
		<p class="wp-empty">{ T(lang, "threads.empty") }</p>
		}
	for _, summary := range threads {
		@ThreadRow(summary, lang)
	}
}

templ ThreadRow(summary store.ThreadSummary, lang Lang) {
	<a
		class={ "wp-thread-row", templ.KV("wp-unread", summary.Thread.Unread > 0) }
		href={ "/messages/" + summary.Thread.ID.String() }
		hx-get={ "/partials/messages/" + summary.Thread.ID.String() }
		hx-target="#tab-content"
		hx-swap="innerHTML show:window:top"
		hx-push-url={ "/messages/" + summary.Thread.ID.String() }
	>
		<span class="wp-avatar" aria-hidden="true" style={ "--av-h: " + fmtInt(avatarHue(summary.Thread.Remote.String())) }>{ avatarFor(summary.Thread.Remote.String()) }</span>
		<span class="wp-thread-text">
			<span class="wp-thread-remote">{ summary.Thread.Remote.String() }</span>
			<span class="wp-thread-preview">{ preview(summary.LastBody, summary.LastChannel, lang) }</span>
		</span>
		<span class="wp-thread-side">
			<span class="wp-thread-when">{ relativeTime(summary.Thread.LastActivityAt) }</span>
			if summary.Thread.Unread > 0 {
				<span class="wp-nav-badge">{ fmtInt(summary.Thread.Unread) }</span>
			}
		</span>
	</a>
}

// NewMessageForm starts a conversation with a typed number.
templ NewMessageForm(prefillTo string, lang Lang) {
	<form
		class="wp-compose wp-compose-new"
		hx-post="/messages/send"
		hx-target="#tab-content"
		hx-swap="innerHTML"
		hx-encoding="multipart/form-data"
		enctype="multipart/form-data"
	>
		<input
			name="to"
			inputmode="tel"
			required
			placeholder={ T(lang, "compose.to.ph") }
			aria-label={ T(lang, "compose.to.label") }
			value={ prefillTo }
		></input>
		<input name="body" placeholder={ T(lang, "compose.body.ph") } aria-label={ T(lang, "compose.body.label") }></input>
		<button type="submit" class="wp-primary">{ T(lang, "compose.send") }</button>
	</form>
}

// ThreadView is one open conversation: transcript and reply composer.
type ThreadViewProps struct {
	Thread   domain.Thread
	Messages []domain.Message
	Error    string
	// Page is the transcript window currently shown (0 = newest); HasMore
	// reports older pages beyond the window.
	Page    int
	HasMore bool
	// Identity is the extension's presented number (DID); empty = unknown.
	Identity string
	Lang     Lang
}

templ ThreadView(props ThreadViewProps) {
	<section class="wp-panel" id="messages-panel">
		<header class="wp-panel-head wp-thread-head">
			<a
				class="wp-back"
				href="/messages"
				hx-get="/partials/messages"
				hx-target="#tab-content"
				hx-swap="innerHTML show:window:top"
				hx-push-url="/messages"
			>← All messages</a>
			<h2>{ props.Thread.Remote.String() }</h2>
			<button class="wp-primary" data-dial={ props.Thread.Remote.String() }>{ T(props.Lang, "contacts.call") }</button>
		</header>
		if props.Error != "" {
			<p class="wp-error" role="alert">{ props.Error }</p>
		}
		if props.HasMore {
			<form
				class="wp-older"
				hx-get={ "/partials/messages/" + props.Thread.ID.String() + "?older=" + fmtInt(props.Page+1) }
				hx-target="#tab-content"
				hx-swap="innerHTML show:window:top"
				hx-trigger="submit"
			>
				<button type="submit">{ T(props.Lang, "thread.loadOlder") }</button>
			</form>
		}
		<div
			class="wp-transcript"
			id="thread-transcript"
			sse-swap="thread"
			hx-swap="morph:innerHTML"
			data-page={ fmtInt(props.Page) }
			data-thread={ props.Thread.ID.String() }
		>
			@Transcript(props.Messages, props.Lang)
		</div>
		if props.Identity != "" {
			<p class="wp-identity">{ T(props.Lang, "identity.from") } <strong>{ props.Identity }</strong></p>
		}
		<form
			class="wp-compose"
			hx-post={ "/messages/send?thread=" + props.Thread.ID.String() }
			hx-target="#tab-content"
			hx-swap="innerHTML show:window:bottom"
			hx-encoding="multipart/form-data"
			enctype="multipart/form-data"
		>
			<input type="hidden" name="to" value={ props.Thread.Remote.String() }></input>
			<input name="body" placeholder={ T(props.Lang, "compose.reply.ph") } aria-label={ T(props.Lang, "compose.body.label") }></input>
			<input
				type="file"
				name="attachment"
				multiple
				accept="image/*,application/pdf,.vcf"
				aria-label="Attachments"
			></input>
			<button type="submit" class="wp-primary">{ T(props.Lang, "compose.send") }</button>
		</form>
	</section>
}

// Transcript renders the message bubbles, oldest first. It is the payload
// of the SSE "thread" event: the swap replaces #thread-transcript's
// innerHTML with exactly these bubbles, so an open conversation updates
// live while the reply composer below stays untouched. The host div also
// carries data-page/data-thread (shell.js contract): pushes are cancelled
// while older pages are open, and a newest-page push marks the thread
// read client-side.
templ Transcript(messages []domain.Message, lang Lang) {
	for _, msg := range messages {
		@Bubble(msg, lang)
	}
}

templ Bubble(msg domain.Message, lang Lang) {
	<div class={ "wp-bubble", templ.KV("wp-out", msg.Direction == domain.DirectionOutbound) }>
		if msg.Body != "" {
			<p class="wp-bubble-body">{ msg.Body }</p>
		}
		for _, att := range msg.Attachments {
			<a class="wp-attachment" href={ "/attachments/" + att.ID.String() } download={ att.Name }>
				📎 { att.Name } <span class="wp-muted">({ fmtInt(int(att.SizeBytes>>10)) } KiB)</span>
			</a>
		}
		<span class="wp-bubble-meta">
			{ msg.CreatedAt.Local().Format(time.Kitchen) }
			if msg.Direction == domain.DirectionOutbound {
				@OutboundStatusBadge(msg.Status, lang)
			}
		</span>
	</div>
}

templ OutboundStatusBadge(status domain.OutboundStatus, lang Lang) {
	switch status {
	case domain.StatusQueued:
		<span class="wp-status wp-status-queued">{ T(lang, "status.sending") }</span>
	case domain.StatusSent:
		<span class="wp-status wp-status-sent">{ T(lang, "status.sent") }</span>
	case domain.StatusDelivered:
		<span class="wp-status wp-status-delivered">{ T(lang, "status.delivered") }</span>
	case domain.StatusFailed:
		<span class="wp-status wp-status-failed">{ T(lang, "status.failed") }</span>
	default:
		<span></span>
	}
}

func preview(body string, channel domain.Channel, lang Lang) string {
	if channel == domain.ChannelMMS && body == "" {
		return T(lang, "media.preview")
	}
	if body == "" {
		return T(lang, "preview.empty")
	}
	return body
}

func relativeTime(t time.Time) string {
	delta := time.Since(t)
	switch {
	case delta < time.Minute:
		return "now"
	case delta < time.Hour:
		return fmtInt(int(delta.Minutes())) + "m"
	case delta < 24*time.Hour:
		return fmtInt(int(delta.Hours())) + "h"
	default:
		return t.Local().Format("Jan 2, 15:04")
	}
}

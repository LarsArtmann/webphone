package views

import (
	"time"

	"github.com/larsartmann/webphone/internal/domain"
	"github.com/larsartmann/webphone/internal/store"
)

// ThreadsPanel is the Messages tab's landing view: the thread list plus a
// composer for new conversations. sse-swap="threads" lets the server push
// a fresh list whenever a message arrives or sends.
type ThreadsPanelProps struct {
	Threads []store.ThreadSummary
	Error   string
}

templ ThreadsPanel(props ThreadsPanelProps) {
	<section class="wp-panel" id="messages-panel" sse-swap="threads">
		<header class="wp-panel-head">
			<h2>Messages</h2>
			<p class="wp-panel-sub">SMS and MMS threads for your extension.</p>
		</header>
		if props.Error != "" {
			<p class="wp-error" role="alert">{ props.Error }</p>
		}
		@NewMessageForm("")
		if len(props.Threads) == 0 {
			<p class="wp-empty">No conversations yet — send the first message above.</p>
		}
		for _, summary := range props.Threads {
			@ThreadRow(summary)
		}
	</section>
}

templ ThreadRow(summary store.ThreadSummary) {
	<a
		class="wp-thread-row"
		href={ "/messages/" + summary.Thread.ID.String() }
		hx-get={ "/partials/messages/" + summary.Thread.ID.String() }
		hx-target="#tab-content"
		hx-swap="innerHTML show:window:top"
		hx-push-url={ "/messages/" + summary.Thread.ID.String() }
	>
		<span class="wp-thread-remote">{ summary.Thread.Remote.String() }</span>
		<span class="wp-thread-preview">{ preview(summary.LastBody, summary.LastChannel) }</span>
		<span class="wp-thread-when">{ relativeTime(summary.Thread.LastActivityAt) }</span>
		if summary.Thread.Unread > 0 {
			<span class="wp-nav-badge">{ fmtInt(summary.Thread.Unread) }</span>
		}
	</a>
}

// NewMessageForm starts a conversation with a typed number.
templ NewMessageForm(prefillTo string) {
	<form
		class="wp-compose wp-compose-new"
		hx-post="/messages/send"
		hx-target="#tab-content"
		hx-swap="innerHTML"
		hx-encoding="multipart/form-data"
		enctype="multipart/form-data"
	>
		<input
			name="to"
			inputmode="tel"
			required
			placeholder="Number, e.g. +441632960961"
			aria-label="Recipient number"
			value={ prefillTo }
		></input>
		<input name="body" placeholder="Message" aria-label="Message text"></input>
		<button type="submit" class="wp-primary">Send</button>
	</form>
}

// ThreadView is one open conversation: transcript and reply composer.
type ThreadViewProps struct {
	Thread   domain.Thread
	Messages []domain.Message
	Error    string
}

templ ThreadView(props ThreadViewProps) {
	<section class="wp-panel" id="messages-panel">
		<header class="wp-panel-head wp-thread-head">
			<a
				class="wp-back"
				href="/messages"
				hx-get="/partials/messages"
				hx-target="#tab-content"
				hx-swap="innerHTML show:window:top"
				hx-push-url="/messages"
			>← All messages</a>
			<h2>{ props.Thread.Remote.String() }</h2>
		</header>
		if props.Error != "" {
			<p class="wp-error" role="alert">{ props.Error }</p>
		}
		<div class="wp-transcript" id="thread-transcript" sse-swap="thread">
			for _, msg := range props.Messages {
				@Bubble(msg)
			}
		</div>
		<form
			class="wp-compose"
			hx-post={ "/messages/send?thread=" + props.Thread.ID.String() }
			hx-target="#tab-content"
			hx-swap="innerHTML show:window:bottom"
			hx-encoding="multipart/form-data"
			enctype="multipart/form-data"
		>
			<input type="hidden" name="to" value={ props.Thread.Remote.String() }></input>
			<input name="body" placeholder="Reply…" aria-label="Message text"></input>
			<input
				type="file"
				name="attachment"
				multiple
				accept="image/*,application/pdf,.vcf"
				aria-label="Attachments"
			></input>
			<button type="submit" class="wp-primary">Send</button>
		</form>
	</section>
}

templ Bubble(msg domain.Message) {
	<div class={ "wp-bubble", templ.KV("wp-out", msg.Direction == domain.DirectionOutbound) }>
		if msg.Body != "" {
			<p class="wp-bubble-body">{ msg.Body }</p>
		}
		for _, att := range msg.Attachments {
			<a class="wp-attachment" href={ "/attachments/" + att.ID.String() } download={ att.Name }>
				📎 { att.Name } <span class="wp-muted">({ fmtInt(int(att.SizeBytes>>10)) } KiB)</span>
			</a>
		}
		<span class="wp-bubble-meta">
			{ msg.CreatedAt.Local().Format(time.Kitchen) }
			if msg.Direction == domain.DirectionOutbound {
				@OutboundStatusBadge(msg.Status)
			}
		</span>
	</div>
}

templ OutboundStatusBadge(status domain.OutboundStatus) {
	switch status {
	case domain.StatusQueued:
		<span class="wp-status wp-status-queued">sending…</span>
	case domain.StatusSent:
		<span class="wp-status wp-status-sent">sent</span>
	case domain.StatusDelivered:
		<span class="wp-status wp-status-sent">delivered</span>
	case domain.StatusFailed:
		<span class="wp-status wp-status-failed">failed</span>
	default:
		<span></span>
	}
}

func preview(body string, channel domain.Channel) string {
	if channel == domain.ChannelMMS && body == "" {
		return "📎 media"
	}
	if body == "" {
		return "(empty)"
	}
	return body
}

func relativeTime(t time.Time) string {
	delta := time.Since(t)
	switch {
	case delta < time.Minute:
		return "now"
	case delta < time.Hour:
		return fmtDurationMinutes(int(delta.Minutes())) + "m"
	case delta < 24*time.Hour:
		return fmtDurationMinutes(int(delta.Hours())) + "h"
	default:
		return t.Local().Format("Jan 2, 15:04")
	}
}

func fmtDurationMinutes(n int) string {
	return fmtInt(n)
}

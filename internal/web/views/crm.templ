package views

import (
	"github.com/larsartmann/webphone/internal/domain"
)

// crmNameLink is the ONE place a CRM link is built. It renders the
// contact's published name as a link into the CRM's own UI when the
// deployment configured a deep-link template, and the plain name otherwise:
// zero CRM config renders byte-identically to the pre-integration product,
// and a miss never grows a dead affordance.
//
// Sites must be non-anchor containers (a heading, a row <article>): an <a>
// inside the list's row link would be invalid HTML and a nested hit target.
// The link opens in a NEW TAB on purpose, so the SIP island (registration,
// a live call) is never unloaded by a navigation.
// crmAnchor is the ONE home of the CRM's external anchor: the profile
// link and the create affordance are the same shape (new tab, noopener,
// a title and a "<who>, <title>" label), and two hand-kept copies would
// drift the day one gains an attribute.
templ crmAnchor(href, class, text, who, title string) {
	<a
		class={ class }
		href={ href }
		target="_blank"
		rel="noopener noreferrer"
		title={ title }
		aria-label={ who + ", " + title }
	>{ text }</a>
}

templ crmNameLink(number string, contacts CRMContacts, lang Lang) {
	if url := crmProfileURL(number, contacts); url != "" {
		@crmAnchor(url, "wp-crm-link", displayName(number, contacts), displayName(number, contacts), T(lang, "crm.open"))
	} else {
		{ displayName(number, contacts) }
	}
}

// crmCreateLink renders the new-contact affordance for an UNKNOWN number:
// the deployment's create-form template with {phone} substituted. Empty
// template renders nothing (the byte-identical zero-config product), a
// MATCHED number renders nothing (its profile link is the affordance
// there), and the CRM still owns the record — this opens the CRM's OWN
// form in a NEW TAB (the SIP island never unloads), which keeps the
// browser→CRM surface at exactly the operator's own navigation.
templ crmCreateLink(number string, createURL string, contacts CRMContacts, lang Lang) {
	if createURL != "" && crmProfileURL(number, contacts) == "" {
		@crmAnchor(crmCreateURLFor(number, createURL), "wp-crm-create", T(lang, "crm.create"), displayName(number, contacts), T(lang, "crm.create"))
	}
}

// remoteLabel is the ONE home of a row's remote-party label: the resolved
// name, linked into the CRM when a template is configured, in the row's
// canonical strong. Fax rows and History's CDR rows both render exactly this,
// and two hand-kept copies would drift the day one of them gains an
// attribute. A remote the phone alphabet cannot read renders muted mono
// instead: it is not a number, and a number-shaped strong would lie about
// what the PBX sent.
templ remoteLabel(number string, contacts CRMContacts, lang Lang) {
	if _, err := domain.ParsePhone(number); err != nil {
		<span class="wp-muted wp-mono">{ number }</span>
	} else {
		<strong class="wp-thread-remote">@crmNameLink(number, contacts, lang)</strong>
	}
}

// crmDraftContact is a draft's caller label: the CRM-served name LINKED
// through crmNameLink (with the dialable number kept beside it — the
// draft's whole point is who to call back), the contactLabel ladder
// otherwise. Zero CRM config renders byte-identically to the
// pre-integration product, so the drafts panel gains an affordance only
// when the deployment can actually serve one. Draft contacts are keyed
// WITHOUT the leading + (the drafts store's own vocabulary), which is why
// this component exists beside remoteLabel instead of reusing it.
templ crmDraftContact(contacts CRMContacts, contact string, lang Lang) {
	if crmProfileURL(contact, contacts) != "" {
		@crmNameLink(contact, contacts, lang)
		<span class="wp-crm-muted">+{ contact }</span>
	} else {
		{ contactLabel(contacts, contact) }
	}
}

// crmContextItem is the ONE home of a context item's shape: a muted uppercase
// key, the value, and an optional muted tail. Four hand-kept copies of this
// markup would drift the day one of them gains an attribute, and the detector
// rightly calls four copies of one shape a clone.
templ crmContextItem(key, value, tail string) {
	<span class="wp-crm-item">
		<span class="wp-crm-key">{ key }</span>
		<span>{ value }</span>
		if tail != "" {
			<span class="wp-crm-muted">{ tail }</span>
		}
	</span>
}

// crmMutedItem is the ONE home of the context row's muted meta line: the
// cache notice and the deal overflow are two conditional spans of one
// shape, and a second hand-kept copy drifts the day the styling moves.
templ crmMutedItem(text string) {
	<span class="wp-crm-item wp-crm-muted">{ text }</span>
}

// crmContextStrip renders the CRM's published context for the one contact
// the surface is about: the company, the open deals, the outstanding task
// count, and when the CRM last saw activity with them.
//
// It sits BESIDE the panel head, never inside it: ThreadHead is a hot
// outerHTML swap target (flag toggles re-render exactly it), so a strip
// inside would cost a CRM round trip per pin/unpin and could be blanked by
// a toggle.
//
// Deliberately NOT a row of chips or boxes: inside a panel the design
// language is a flat row, never a box-in-box. This is one wrapping line of
// key-plus-value items over a hairline, and rendering NOTHING when there is
// nothing to say is the whole degradation contract: no empty shell, no
// placeholder, no spinner.
templ crmContextStrip(crm *CRMContext, lang Lang) {
	if crm != nil {
		<aside class="wp-crm-context" id="wp-crm-context" aria-label={ T(lang, "crm.context") }>
			@crmContextItems(crm, lang)
		</aside>
	}
}

// crmContextItems is the ONE home of the context row's content: the
// company, the open deals, the outstanding task count and the last touch.
// Two surfaces render these lines — the conversation head's strip and the
// live-call panel beside the island — and a second hand-kept copy would
// drift the day one of them learns a new fact.
templ crmContextItems(crm *CRMContext, lang Lang) {
	if crm != nil {
		if crm.ServedFromCache {
			@crmMutedItem(T(lang, "crm.cached"))
		}
		if crm.Company != "" {
			@crmContextItem(T(lang, "crm.company"), crm.Company, "")
		}
		for _, deal := range crm.Deals {
			@crmContextItem(T(lang, "crm.deal")+" · "+deal.Stage, deal.Title, dealValue(deal))
		}
		if crm.MoreDeals > 0 {
			@crmMutedItem("+" + fmtInt(crm.MoreDeals))
		}
		if crm.OpenTasks > 0 {
			@crmContextItem(T(lang, "crm.tasks"), fmtInt(crm.OpenTasks), crmNextTaskTail(*crm, lang))
		}
		if !crm.LastActivity.IsZero() {
			@crmContextItem(T(lang, "crm.lastActivity"), relativeTime(crm.LastActivity, lang), "")
		}
	}
}

// crmNextTaskTail is the next follow-up's one-line description: its title,
// plus the due phrase when the CRM published a due date. Built here rather
// than in the template so the " · " separator cannot dangle when there is no
// due date to show.
func crmNextTaskTail(ctx CRMContext, lang Lang) string {
	if ctx.NextTask == "" {
		return ""
	}

	if due := crmTaskDue(ctx, lang); due != "" {
		return ctx.NextTask + " · " + due
	}

	return ctx.NextTask
}

package views

import (
	"strings"
	"time"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/webphone/internal/pbx"
)

// HistoryPanel shows the extension's server-side call records (CDR) from
// the phone API. The browser-local "recent calls" of the island stay in the
// phone panel — this tab is the operator's view.
type HistoryPanelProps struct {
	Enabled bool
	Entries []pbx.CDR
	Error   string
	// Current filters (echoed back into the form after a re-render).
	Query   string
	Dir     string
	Outcome string
	// Names maps phone numbers to CRM contact names (optional integration);
	// unresolved numbers render verbatim.
	Names map[string]string
	// Transcripts are the extension's own live-call transcript groups
	// (owner-scoped store, newest call first). They render as their own
	// section — the CDR rows carry no call uuid, so joining the two lists
	// would be guesswork, not correlation.
	Transcripts []TranscriptGroup
	Lang        Lang
}

templ HistoryPanel(props HistoryPanelProps) {
	<section class="wp-panel" id="history-panel">
		@panelHead(props.Lang, "tab.history", "history.subtitle")
		if props.Enabled {
			// E2: the filter state is URL-addressable — the form pushes its
			// request URL (query included), so a filtered view is a
			// shareable/deep-linkable address.
			<form
				class="wp-filter"
				hx-get="/partials/history"
				hx-target="#history-panel"
				hx-swap="outerHTML"
				hx-trigger="submit"
				hx-push-url="true"
			>
				<input
					type="search"
					name="q"
					placeholder={ T(props.Lang, "history.filter.ph") }
					value={ props.Query }
					aria-label={ T(props.Lang, "history.filter.label") }
				/>
				<select name="dir" aria-label={ T(props.Lang, "history.filter.label") }>
					<option value="" selected?={ props.Dir == "" }>{ T(props.Lang, "history.dir.any") }</option>
					<option value="in" selected?={ props.Dir == "in" }>{ T(props.Lang, "history.dir.in") }</option>
					<option value="out" selected?={ props.Dir == "out" }>{ T(props.Lang, "history.dir.out") }</option>
				</select>
				<select name="outcome" aria-label={ T(props.Lang, "history.outcome.label") }>
					<option value="" selected?={ props.Outcome == "" }>{ T(props.Lang, "history.outcome.any") }</option>
					<option value="answered" selected?={ props.Outcome == "answered" }>{ T(props.Lang, "history.outcome.answered") }</option>
					<option value="missed" selected?={ props.Outcome == "missed" }>{ T(props.Lang, "history.outcome.missed") }</option>
				</select>
				<button type="submit" class="wp-mini">{ T(props.Lang, "history.filter") }</button>
			</form>
		}
		@panelError(props.Error)
		if !props.Enabled {
			<p class="wp-empty">{ T(props.Lang, "history.needsAPI.pre") }<code>phone_api_url</code>{ T(props.Lang, "history.needsAPI.post") }</p>
		}
		if props.Enabled && len(props.Entries) == 0 {
			// Honest empty state (M17 J8): an active outcome filter with no
			// rows must not claim nothing was ever recorded.
			{{ emptyKey := "history.empty"
			   if props.Outcome != "" {
			     emptyKey = "history.emptyFiltered"
			   } }}
			@display.EmptyState(display.EmptyStateProps{Title: T(props.Lang, emptyKey), Icon: icons.Clock})
		}
		// D9: rows group under calendar-day heads (Today / Yesterday /
		// weekday + date, with the group count) — the same separator
		// vocabulary the message transcript established.
		for _, group := range groupCDRsByDay(props.Entries) {
			if group.Key != "" {
				@dayHead(props.Lang, group.Day, len(group.Rows))
			}
			for _, cdr := range group.Rows {
				@CDRRow(cdr, props.Names, props.Lang)
			}
		}
		if len(props.Transcripts) > 0 {
			@TranscriptSection(props)
		}
	</section>
}

// TranscriptGroup is one reassembled call transcript for the History
// tab: the call's remote party plus its segments in spoken order.
type TranscriptGroup struct {
	// CallID addresses the call for the delete affordance (the store's
	// DeleteCall key — the CDR rows carry no call uuid, so this is the
	// ONLY correlation handle the transcript section has).
	CallID    string
	Remote    string
	Direction string // "in" | "out"
	StartedAt time.Time
	Lines     []string
	// Name is the CRM-resolved contact name (optional); empty renders
	// the raw remote.
	Name string
}

templ TranscriptSection(props HistoryPanelProps) {
	<section class="wp-transcripts" aria-label={ T(props.Lang, "history.transcripts") }>
		<h3>{ T(props.Lang, "history.transcripts") }</h3>
		for _, group := range props.Transcripts {
			<details class="wp-transcript-call">
				<summary>
					<span aria-hidden="true">
						if group.Direction == "in" {
							↓
						} else {
							↑
						}
					</span>
					<strong>{ displayName(firstNonEmpty(group.Name, group.Remote), props.Names) }</strong>
					<span class="wp-muted">{ formatStamp(props.Lang, group.StartedAt) }</span>
				</summary>
				<p class="wp-transcript-text">{ strings.Join(group.Lines, " ") }</p>
				// End-user erasure (GDPR leg): confirm-gated delete of the
				// whole call. The button only carries data — shell.js owns
				// the confirm + DELETE + row removal (the shell works when
				// island scripts fail).
				<button
					class="wp-mini"
					data-delete-transcript={ group.CallID }
					data-confirm={ T(props.Lang, "history.transcript.deleteConfirm") }
					aria-label={ T(props.Lang, "history.transcript.delete") }
					title={ T(props.Lang, "history.transcript.delete") }
				>🗑</button>
			</details>
		}
	</section>
}

// cdrDayGroup is one calendar-day bucket of call records.
type cdrDayGroup struct {
	// Key is the day prefix ("2006-01-02"); "" means the record's start
	// carried no parseable date (the rows render headless rather than
	// under a wrong label).
	Key  string
	Day  time.Time
	Rows []pbx.CDR
}

// groupCDRsByDay buckets consecutive records by their Start date. The
// phone API's start is "YYYY-MM-DD HH:MM", so the bucket key is the
// 10-byte prefix; a short or unparsable start lands in the headless
// group keyed "".
func groupCDRsByDay(entries []pbx.CDR) []cdrDayGroup {
	groups := make([]cdrDayGroup, 0, len(entries))
	for _, cdr := range entries {
		key := ""
		var day time.Time
		if len(cdr.Start) >= 10 {
			if parsed, err := time.ParseInLocation("2006-01-02", cdr.Start[:10], time.Local); err == nil {
				key = cdr.Start[:10]
				day = parsed
			}
		}
		if key != "" && len(groups) > 0 && groups[len(groups)-1].Key == key {
			groups[len(groups)-1].Rows = append(groups[len(groups)-1].Rows, cdr)
			continue
		}
		groups = append(groups, cdrDayGroup{Key: key, Day: day, Rows: []pbx.CDR{cdr}})
	}
	return groups
}

templ CDRRow(cdr pbx.CDR, names map[string]string, lang Lang) {
	<article class={ "wp-row", templ.KV("wp-row-missed", cdrMissed(cdr)) }>
		<span
			class={ "wp-dir-chip", templ.KV("wp-dir-in", cdr.Context == "public"), templ.KV("wp-dir-missed", cdrMissed(cdr)) }
			aria-hidden="true"
		>{ cdrDirGlyph(cdr) }</span>
		<span class="wp-thread-text" role="img" aria-label={ cdrDirLabel(cdr, lang) }>
			<strong class="wp-thread-remote">{ displayName(cdrTarget(cdr), names) }</strong>
			<span class="wp-muted">{ cdr.Start } · { durationLabel(cdr.Billsec) }</span>
		</span>
		if dial := CDRDialTarget(cdr); dial != "" {
			<span class="wp-row-actions">
				<button class="wp-mini" data-dial={ dial }>{ T(lang, "contacts.call") }</button>
				<button class="wp-mini" data-sms={ dial }>{ T(lang, "contacts.sms") }</button>
				<button
					class="wp-mini"
					data-save-contact={ dial }
					data-name={ firstNonEmpty(cdr.CallerIDName, displayName(cdrTarget(cdr), names)) }
					aria-label={ T(lang, "contacts.saveAs") }
					title={ T(lang, "contacts.saveAs") }
				>☆</button>
			</span>
		}
	</article>
}

func cdrDirGlyph(cdr pbx.CDR) string {
	if cdrMissed(cdr) {
		return "✖"
	}
	if cdr.Context == "public" {
		return "↓"
	}
	return "↑"
}

func cdrDirLabel(cdr pbx.CDR, lang Lang) string {
	if cdrMissed(cdr) {
		return T(lang, "history.missed")
	}
	if cdr.Context == "public" {
		return T(lang, "history.dirIn")
	}
	return T(lang, "history.dirOut")
}

// cdrMissed: an inbound leg that never carried media (billsec 0) — the
// caller rang, nobody answered.
func cdrMissed(cdr pbx.CDR) bool {
	return cdr.Context == "public" && cdr.Billsec == 0
}

func cdrTarget(cdr pbx.CDR) string {
	if cdr.Context == "public" {
		return firstNonEmpty(cdr.CallerIDNumber, cdr.CallerIDName, "unknown")
	}
	return firstNonEmpty(cdr.DestinationNumber, "unknown")
}

// CDRDialTarget returns the dialable number for a call record (the CID
// number of the caller for inbound legs, the dialled destination for
// outbound legs) or "" when the record carries none — the dial button
// renders only when a real number exists. Exported: the history panel
// collects the same numbers for CRM name resolution.
func CDRDialTarget(cdr pbx.CDR) string {
	if cdr.Context == "public" {
		return cdr.CallerIDNumber
	}
	return cdr.DestinationNumber
}

func durationLabel(seconds int) string {
	if seconds <= 0 {
		return "—"
	}
	minutes := seconds / 60
	return fmtInt(minutes) + ":" + pad2(seconds%60)
}

func pad2(n int) string {
	if n < 10 {
		return "0" + fmtInt(n)
	}
	return fmtInt(n)
}

func firstNonEmpty(values ...string) string {
	for _, v := range values {
		if v != "" {
			return v
		}
	}
	return ""
}

/* Input for the login-page stylesheet (internal/web/assets/login.css) —
   the cqrs-htmx/loginpage surface at /login. Rebuild ONLY with
   scripts/build-tw-css.sh (tailwindcss v4 ONLY; v3 emits a different
   layer model and breaks the dark variant), staged build, locked nixpkgs
   rev. The artifact NEVER merges with tw.css (the shell build) or
   health.css (the dashboard build).

   Unlike the shell — which links app.css + tw.css as two stylesheets —
   the library page takes ONE CSSPath, so this build INLINES app.css:
   the design tokens the @theme remap resolves through must live in the
   artifact itself. The unlayered-token + layered-utility cascade shape
   is identical to the shell's two-link arrangement (coexistence
   proven).

   The @theme remap below pins the NON-GRAY slots byte-equal to
   tw.css.input's (the build script gates that parity). The GRAY family
   deliberately stays Tailwind's default palette: the loginpage uses
   Tailwind's standard dark idiom, where one gray step serves BOTH a
   background slot and a text slot across themes (the light page
   background vs the dark heading ink; the dark page background vs the
   light heading ink). No single app token can fill both — the shell's
   remap (900 = --text, 50 = --surface-2) inverts the dark page: light
   page background, invisible heading. The accent, white, danger,
   warn, ok and radii remaps carry the brand; the neutrals stay stock
   so the library's own dark design renders correctly (caught by the
   T23 dark shot, 2026-10-25).

   NOTE: never write literal dark-variant utility names in this file's
   comments — the shell build auto-scans this input's directory, and a
   comment mentioning a utility EMITS it into tw.css (the 2026-10-25
   leak, twice-learned). */

@import "tailwindcss";
@import "./app.css";

/* Manual dark mode, EXTENDED for the login page: webphone toggles
   data-theme="dark" on <html> (theme-preload.js + shell.js), while the
   library page's ThemeScript resolves prefers-color-scheme into a .dark
   class on the root (its own preload; the page has no theme-preload.js).
   This variant answers BOTH, so dark: utilities activate on the login
   page whichever mechanism drives them. */

@custom-variant dark (&:where(:root[data-theme="dark"], :root[data-theme="dark"] *, .dark, .dark *));

@theme inline {
  /* accent family (signal green) */
  --color-blue-50: color-mix(in oklab, var(--accent) 10%, transparent);
  --color-blue-100: color-mix(in oklab, var(--accent) 15%, transparent);
  --color-blue-300: var(--accent-strong);
  --color-blue-400: var(--accent-strong);
  --color-blue-500: var(--accent-strong);
  --color-blue-600: var(--accent);
  --color-blue-800: var(--accent);
  --color-blue-900: var(--accent);

  /* Neutral family: deliberately NOT remapped — see the header comment.
     Tailwind's default gray palette renders the library's light/dark
     design correctly; the shell's token remap would invert dark mode. */
  /* white is the on-accent ink for filled buttons; bg-white (secondary
     button in light) resolves to the same #ffffff the light surface
     uses, and dark:bg-gray-800 (stock palette) overrides it in dark. */
  --color-white: var(--on-accent);

  /* danger family */
  --color-red-50: color-mix(in oklab, var(--danger) 10%, transparent);
  --color-red-300: var(--danger);
  --color-red-400: var(--danger);
  --color-red-500: var(--danger);
  --color-red-600: var(--danger);
  --color-red-700: var(--danger);
  --color-red-800: var(--danger);
  --color-red-900: var(--danger);

  /* warning family */
  --color-amber-50: color-mix(in oklab, var(--warn) 10%, transparent);
  --color-amber-300: var(--warn);
  --color-amber-400: var(--warn);
  --color-amber-600: var(--warn);
  --color-amber-700: var(--warn);
  --color-amber-800: var(--warn);
  --color-amber-900: var(--warn);

  /* ok family */
  --color-green-50: color-mix(in oklab, var(--ok) 10%, transparent);
  --color-green-300: var(--ok);
  --color-green-400: var(--ok);
  --color-green-600: var(--ok);
  --color-green-700: var(--ok);
  --color-green-800: var(--ok);
  --color-green-900: var(--ok);

  /* webphone radii (theme-invariant). The literals duplicate app.css
     tokens because Tailwind's own token names (--radius-md/--radius-lg)
     collide with the app names they must follow; build-tw-css.sh
     asserts the values stay in lockstep with app.css. */
  --radius-md: 9px;
  --radius-lg: 12px;
}

/* Scan set, relative to this file (internal/web/assets/): the webphone
   views (same rationale as tw.css.input), the adopted templ-components
   sources (button/input/label/base/icon — the page renders
   forms.Input + display.Button), the feedback pair the page adds
   (Alert + the Spinner inside loading.templ), and the loginpage's own
   page + embedded JS (the lp-* hooks and the "hidden" toggles). */
@source "../../../internal/web/views";
@source "../../../vendor/github.com/larsartmann/templ-components/display/definition_list.templ";
@source "../../../vendor/github.com/larsartmann/templ-components/display/definition_list_templ.go";
@source "../../../vendor/github.com/larsartmann/templ-components/display/empty_state.templ";

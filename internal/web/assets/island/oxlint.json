{
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "suspicious": "off",
    "nursery": "off"
  },
  "rules": {
    "no-undef": "error",
    "no-empty": "error",
    "no-unused-vars": "error",
    "no-console": ["error", { "allow": ["info", "warn", "error"] }]
  },
  "globals": {
    "SIP": "readonly",
    "module": "readonly"
  }
}

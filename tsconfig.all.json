// The WHOLE-TREE measuring project for the annotation campaign: every asset
// file that ships in the binary, checked, whatever its error count. Use it to
// count a file's residue (`tsc -p tsconfig.all.json`) before and after you
// annotate it, then add the file to tsconfig.json's include (the gate) and drop
// it from the debt list in internal/web/assets/typecheck_pin_test.go.
//
// NEVER wire this project into a check: it is red by design until the campaign
// finishes, and the gate is tsconfig.json.
{
  "extends": "./tsconfig.json",
  "include": [
    "types/**/*.d.ts",
    "internal/web/assets/enroll/**/*.js",
    "internal/web/assets/island/app/**/*.js",
    "internal/web/assets/shell.js",
    "internal/web/assets/theme-preload.js"
  ]
}

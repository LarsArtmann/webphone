// THE TYPE GATE. `tsc -p . --noEmit` is green over every served JS file.
//
// The whole asset tree is in scope — the island's ES modules, the shell glue,
// the theme preload and the enrollment page — because TypeScript type-checks a
// module the moment an imported module reaches it: a green file cannot hide a
// red one, so a partial include would only lie about what is covered. One
// carve-out, pinned by internal/web/assets/typecheck_pin_test.go: the vendored
// sip.js bundle is third-party bytes and is never typed.
//
// No `// @ts-check` pragmas anywhere: island sources are served verbatim, so a
// pragma would change a served byte. checkJs + include gives the same checking
// with zero served-byte changes.
//
// VERIFIED GREEN ON: TypeScript 7.0.2 (the devshell pin; `nix build
// nixpkgs#typescript`). The strictness this gate relies on is a compiler
// behaviour, so a devshell bump owes a green `tsc -p . --noEmit` plus the
// `island-typecheck` flake check before it lands.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "auto",
    "types": [],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["types/**/*.d.ts", "internal/web/assets/**/*.js"],
  "exclude": ["internal/web/assets/vendor/**"]
}

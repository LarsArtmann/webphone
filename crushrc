# Project Crush config.
#
# The Go LSPs must run on the flake's OWN Go toolchain: the host go is
# older than go.mod's floor and GOTOOLCHAIN=local forbids toolchain
# downloads, so bare gopls / golangci-lint-langserver fail every go list
# ("go.mod requires go >= ...") and project diagnostics die.
# The LSP commands exec the PREBUILT flake output (scripts/lsp.sh →
# packages.go-lsp): a warm start runs no nix, takes no lock and owns a
# clean stdout. They used to be `nix develop -c gopls`, which re-fetched
# the flake on every start (lock contention across sessions) and put the
# devShell banner on stdout = the LSP wire, so initialize never answered
# (outage 2026-11-21..27). Same reason as above, the servers still come
# from the devShell's own pins (Go 1.27 + GOTOOLCHAIN=local).
# Resolved through `git rev-parse --show-toplevel` so the command also works
# for a session opened in a SUBDIRECTORY of the repo (a relative --command
# is evaluated against the session's working directory).
lsp add gopls --command bash --args -c --args 'exec "$(git rev-parse --show-toplevel)/scripts/lsp.sh" gopls serve'
lsp add golangci_lint_ls --command bash --args -c --args 'exec "$(git rev-parse --show-toplevel)/scripts/lsp.sh" golangci-lint-langserver'
